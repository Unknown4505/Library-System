<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\BookKiosk.Application\BookKiosk.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Loại bỏ hoàn toàn thư mục Tests và Fixtures khỏi gói Publish Release -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Tests\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>

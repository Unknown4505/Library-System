@{
    Layout = null; // Trang Login có layout riêng, không dùng _Layout có Sidebar
    ViewData["Title"] = "Đăng nhập - BookKiosk CMS";
}
@model BookKiosk.CMS.Models.Auth.LoginRequestModel
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: stretch;
            background: var(--bk-gray-100);
        }

        /* Panel trái: Minh hoạ thương hiệu */
        .login-brand-panel {
            width: 42%;
            background: linear-gradient(145deg, #1c4587 0%, var(--bk-primary) 60%, #2980b9 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .login-brand-panel::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .login-brand-panel::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -60px;
            width: 250px;
            height: 250px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .brand-logo-icon {
            font-size: 5rem;
            margin-bottom: 1.5rem;
            opacity: 0.95;
        }

        .brand-title {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .brand-subtitle {
            font-size: 1rem;
            opacity: 0.8;
            text-align: center;
            line-height: 1.6;
            max-width: 280px;
        }

        .brand-features {
            margin-top: 2.5rem;
            list-style: none;
            padding: 0;
            width: 100%;
            max-width: 300px;
        }

        .brand-features li {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0;
            font-size: 0.9rem;
            opacity: 0.85;
        }

        .brand-features li i {
            font-size: 1rem;
            width: 20px;
            text-align: center;
            opacity: 0.9;
        }

        /* Panel phải: Form đăng nhập */
        .login-form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
        }

        .login-card-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-card-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--bk-dark);
            margin-bottom: 0.25rem;
        }

        .login-card-header p {
            color: var(--bk-gray-600);
            font-size: 0.95rem;
        }

        .form-control {
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
        }

        .input-group-text {
            background-color: transparent;
            border-right: none;
            color: var(--bk-gray-600);
        }

        .input-group .form-control {
            border-left: none;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--bk-primary);
            color: var(--bk-primary);
        }

        .btn-login {
            padding: 0.8rem;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            background-color: var(--bk-primary);
            border-color: var(--bk-primary);
            border-radius: var(--bk-radius);
            transition: var(--bk-transition);
        }

        .btn-login:hover {
            background-color: var(--bk-primary-hover);
            border-color: var(--bk-primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(36, 87, 166, 0.3);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--bk-dark);
        }

        @@media (max-width: 768px) {
            .login-brand-panel {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Panel Trái: Thương hiệu -->
    <div class="login-brand-panel d-none d-md-flex">
        <i class="fas fa-book-reader brand-logo-icon"></i>
        <div class="brand-title">BookKiosk CMS</div>
        <div class="brand-subtitle">Hệ thống Quản trị Nhà sách thông minh</div>
        <ul class="brand-features">
            <li><i class="fas fa-desktop"></i> Quản lý Kiosk tự phục vụ</li>
            <li><i class="fas fa-cash-register"></i> Bán hàng tại quầy (POS)</li>
            <li><i class="fas fa-chart-line"></i> Báo cáo doanh thu thời gian thực</li>
            <li><i class="fas fa-warehouse"></i> Quản lý kho hàng & Nhà cung cấp</li>
            <li><i class="fas fa-id-card"></i> Chương trình thẻ thành viên</li>
        </ul>
    </div>

    <!-- Panel Phải: Form Đăng nhập -->
    <div class="login-form-panel">
        <div class="login-card">
            <div class="login-card-header">
                <div class="d-md-none mb-3">
                    <i class="fas fa-book-reader fs-1 text-primary"></i>
                </div>
                <h1>Xin chào!</h1>
                <p>Vui lòng đăng nhập để quản lý hệ thống.</p>
            </div>

            @* Hiển thị lỗi chung (sai mật khẩu, tài khoản bị khóa...) *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded d-flex align-items-center gap-2" style="display:none!important;"></div>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
            {
                <div class="alert alert-danger py-2 small rounded d-flex align-items-center gap-2">
                    <i class="fas fa-exclamation-circle"></i>
                    @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <span>@err.ErrorMessage</span>
                    }
                </div>
            }

            <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" id="loginForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Tên đăng nhập -->
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0">
                            <i class="fas fa-user fa-sm"></i>
                        </span>
                        <input asp-for="Username"
                               class="form-control border-start-0"
                               placeholder="Nhập tên đăng nhập"
                               autocomplete="username"
                               autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Mật khẩu -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0">
                            <i class="fas fa-lock fa-sm"></i>
                        </span>
                        <input asp-for="Password"
                               class="form-control border-start-0"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password"
                               id="passwordInput" />
                        <button class="btn btn-outline-secondary border-start-0"
                                type="button"
                                id="togglePassword"
                                tabindex="-1"
                                title="Hiện / ẩn mật khẩu">
                            <i class="fas fa-eye fa-sm" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Ghi nhớ đăng nhập -->
                <div class="mb-4 d-flex align-items-center">
                    <input asp-for="RememberMe" class="form-check-input me-2" type="checkbox" id="RememberMe" />
                    <label class="form-check-label text-muted small" for="RememberMe">
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <!-- Nút Đăng nhập -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-login" id="loginBtn">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        <span id="loginBtnText">Đăng nhập</span>
                    </button>
                </div>
            </form>

            <!-- Footer nhỏ dưới form -->
            <div class="text-center mt-4 text-muted small">
                <i class="fas fa-shield-alt me-1 text-success"></i>
                Kết nối bảo mật HTTPS | BookKiosk CMS v1.0
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Hiện/ẩn mật khẩu
        document.getElementById('togglePassword')?.addEventListener('click', function () {
            const pwd = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            if (!pwd || !icon) return;
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                pwd.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        });

        // Hiển thị loading trên nút khi submit
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('loginBtn');
            const btnText = document.getElementById('loginBtnText');
            if (btn && btnText) {
                btn.disabled = true;
                btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Đang đăng nhập...';
            }
        });
    </script>
</body>
</html>

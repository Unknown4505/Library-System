@{
    Layout = null;
    ViewData["Title"] = "Không có quyền truy cập - BookKiosk CMS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bk-gray-100);
        }

        .access-denied-card {
            max-width: 500px;
            text-align: center;
            padding: 3rem 2.5rem;
            background: white;
            border-radius: var(--bk-radius-lg);
            box-shadow: var(--bk-shadow);
        }

        .error-icon {
            font-size: 5rem;
            color: var(--bk-warning);
            margin-bottom: 1.5rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        .error-code {
            font-size: 4.5rem;
            font-weight: 800;
            color: var(--bk-danger);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        .error-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--bk-dark);
            margin-bottom: 0.75rem;
        }

        .error-description {
            color: var(--bk-gray-600);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }
    </style>
</head>
<body>
    <div class="access-denied-card">
        <div class="error-icon">
            <i class="fas fa-shield-exclamation"></i>
        </div>
        <div class="error-code">403</div>
        <div class="error-title">Không có quyền truy cập</div>
        <p class="error-description">
            Tài khoản <strong>@User.Identity?.Name</strong> với vai trò
            <strong class="text-danger">@(User.IsInRole("Admin") ? "Admin" : "Staff")</strong>
            không có quyền truy cập vào trang này.
            <br /><br />
            Nếu bạn cho rằng đây là nhầm lẫn, vui lòng liên hệ quản trị viên hệ thống.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                <i class="fas fa-home me-2"></i>Trang chủ
            </a>
        </div>
        <div class="mt-3 text-muted small">
            <i class="fas fa-info-circle me-1"></i>
            Nếu cần hỗ trợ, liên hệ: <strong>IT Support</strong>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

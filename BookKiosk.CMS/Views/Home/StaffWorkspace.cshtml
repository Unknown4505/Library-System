@model BookKiosk.CMS.ViewModels.Dashboard.StaffWorkspaceViewModel
@{
    var canHandleOrders = User.IsInRole("Admin") || User.IsInRole("Staff");
    var canReceiveStock = User.IsInRole("Admin") || User.IsInRole("Manager");
    ViewData["Title"] = "Bàn làm việc nhân viên - BookKiosk Staff";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-page">
@if (Model.UseMockApi)
{
    <div class="alert alert-warning py-2 mb-4 d-flex align-items-center shadow-sm" role="alert">
        <i class="fas fa-flask-vial fa-lg me-2 text-warning"></i>
        <div>
            <strong>Chế độ Mock:</strong> Hệ thống đang sử dụng dữ liệu giả lập (Cms:UseMockApi = true). Các tác nghiệp không phản ánh cơ sở dữ liệu thật.
        </div>
    </div>
}

<!-- Page Header -->
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 fw-bold text-dark">
            <i class="fas fa-briefcase text-primary me-2"></i>Bàn làm việc nhân viên
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Hệ thống</a></li>
                <li class="breadcrumb-item active">Bàn làm việc nhân viên</li>
            </ol>
        </nav>
    </div>
    <div class="text-muted small">
        <i class="fas fa-clock me-1"></i>
        Thời gian: @DateTimeHelper.FormatVietnamDateTime(DateTime.UtcNow)
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <p class="text-muted mb-0 flex-grow-1">Theo dõi các việc cần xử lý. Các chức năng khác nằm trong menu điều hướng.</p>
    @if (canHandleOrders)
    {
        <a asp-controller="Pos" asp-action="Index" class="btn btn-primary"><i class="fas fa-cash-register me-2"></i>Mở bán tại quầy</a>
    }
</div>

<!-- Hai Widget Tác nghiệp: Đơn cần hỗ trợ & Sách sắp hết kho -->
<div class="row g-4">
    <!-- Widget 1: Đơn hàng cần hỗ trợ / Đối soát -->
    <div class="col-xl-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex flex-wrap gap-3 justify-content-between align-items-center border-bottom">
                <h2 class="h6 m-0 fw-bold text-dark">
                    <i class="fas fa-headset text-danger me-2"></i>Đơn hàng Kiosk cần hỗ trợ
                </h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.NeedsSupportCount > 0 ? "bg-danger" : "bg-secondary") small">
                        @(Model.IsOrdersUnavailable ? "Không khả dụng" : $"Đang hiển thị {Model.NeedsSupportCount} đơn")
                    </span>
                    @if (canHandleOrders)
                    {
                        <a asp-controller="Orders" asp-action="Index" asp-route-tab="support" class="btn btn-sm btn-outline-danger py-0 px-2" title="Mở danh sách hỗ trợ đầy đủ">
                        Xem tất cả
                    </a>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.IsOrdersUnavailable)
                {
                    <div class="alert alert-warning m-3 py-3 text-center small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Không thể tải danh sách đơn hàng cần hỗ trợ từ máy chủ.
                    </div>
                }
                else if (!Model.NeedsSupportOrders.Any())
                {
                    <div class="text-center text-success py-5">
                        <i class="fas fa-circle-check fa-3x mb-2 d-block"></i>
                        <span class="fw-semibold">Tất cả đơn hàng hoạt động bình thường!</span>
                        <div class="text-muted small mt-1">Không có đơn hàng nào tại Kiosk đang cần can thiệp xử lý.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive" tabindex="0" aria-label="Danh sách xem trước">
                        <table class="table table-hover align-middle mb-0">
                            <caption class="visually-hidden">Danh sách xem trước tối đa 10 mục</caption>
                            <thead class="table-light">
                                <tr class="small text-uppercase text-secondary">
                                    <th scope="col" style="width: 35%;">Mã đơn</th>
                                    <th scope="col" style="width: 20%;">Kênh</th>
                                    <th scope="col" style="width: 25%;">Thời gian</th>
                                    <th scope="col" style="width: 20%;" class="text-end">Xử lý</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.NeedsSupportOrders)
                                {
                                    <tr>
                                        <td>
                                            @if (canHandleOrders)
                                            {
                                                <a asp-controller="Orders" asp-action="Index" asp-route-orderCode="@order.OrderCode" class="fw-bold text-decoration-none">
                                                <code>@order.OrderCode</code>
                                                </a>
                                            }
                                            else
                                            {
                                                <code>@order.OrderCode</code>
                                            }
                                            <div class="small">
                                                @if (order.OrderStatus == BookKiosk.CMS.Models.Api.Orders.OrderStatus.Pending)
                                                {
                                                    <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.7rem;">Chờ xử lý</span>
                                                }
                                                else if (order.OrderStatus == BookKiosk.CMS.Models.Api.Orders.OrderStatus.Cancelled)
                                                {
                                                    <span class="badge bg-danger py-0 px-1" style="font-size: 0.7rem;">Đã hủy</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary py-0 px-1" style="font-size: 0.7rem;">Cần đối soát</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (order.SaleChannel == BookKiosk.CMS.Models.Api.Orders.SaleChannel.Kiosk)
                                            {
                                                <span class="badge bg-info-subtle text-info border small"><i class="fas fa-desktop me-1"></i>Kiosk</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border small"><i class="fas fa-cash-register me-1"></i>Quầy</span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @DateTimeHelper.FormatVietnamDateTime(order.CreatedAt)
                                        </td>
                                        <td class="text-end">
                                            @if (canHandleOrders)
                                            {
                                                <a asp-controller="Orders" asp-action="Index" asp-route-orderCode="@order.OrderCode" class="btn btn-sm btn-outline-danger py-0 px-2" title="Mở chi tiết đối soát" aria-label="Xử lý đơn @order.OrderCode">
                                                <i class="fas fa-arrow-right"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Widget 2: Cảnh báo Sách sắp hết kho (Tồn <= 5) -->
    <div class="col-xl-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex flex-wrap gap-3 justify-content-between align-items-center border-bottom">
                <h2 class="h6 m-0 fw-bold text-dark">
                    <i class="fas fa-triangle-exclamation text-warning me-2"></i>Sách sắp hết kho
                </h2>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(Model.LowStockCount > 0 ? "bg-warning text-dark" : "bg-secondary") small">
                        @(Model.IsLowStockUnavailable ? "Không khả dụng" : $"Đang hiển thị {Model.LowStockCount} đầu sách")
                    </span>
                    <a asp-controller="Inventory" asp-action="Stock" asp-route-lowOnly="true" class="btn btn-sm btn-outline-primary py-0 px-2" title="Xem danh sách tồn kho">
                        Xem kho
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.IsLowStockUnavailable)
                {
                    <div class="alert alert-warning m-3 py-3 text-center small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Không thể tải danh sách tồn kho từ máy chủ.
                    </div>
                }
                else if (!Model.LowStockItems.Any())
                {
                    <div class="text-center text-success py-5">
                        <i class="fas fa-circle-check fa-3x mb-2 d-block"></i>
                        <span class="fw-semibold">Tồn kho tại quầy và kho phụ an toàn!</span>
                        <div class="text-muted small mt-1">Hiện không có đầu sách nào dưới ngưỡng cảnh báo.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive" tabindex="0" aria-label="Danh sách xem trước">
                        <table class="table table-hover align-middle mb-0">
                            <caption class="visually-hidden">Danh sách xem trước tối đa 10 mục</caption>
                            <thead class="table-light">
                                <tr class="small text-uppercase text-secondary">
                                    <th scope="col" style="width: 25%;">Mã vạch</th>
                                    <th scope="col" style="width: 45%;">Tựa sách</th>
                                    <th scope="col" style="width: 15%;" class="text-center">Tồn</th>
                                    <th scope="col" style="width: 15%;" class="text-end">Nhập</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LowStockItems)
                                {
                                    <tr>
                                        <td>
                                            <code class="small">@item.Barcode</code>
                                        </td>
                                        <td>
                                            <div class="text-truncate fw-semibold text-dark small" style="max-width: 200px;" title="@item.Title">
                                                @item.Title
                                            </div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@item.CategoryName</div>
                                        </td>
                                        <td class="text-center">
                                            @if (item.AvailableStock <= 0)
                                            {
                                                <span class="badge bg-danger py-0 px-1" style="font-size: 0.7rem;">0</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark py-0 px-1" style="font-size: 0.7rem;">@item.AvailableStock</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (canReceiveStock)
                                            {
                                                <a asp-controller="Inventory" asp-action="Create" class="btn btn-sm btn-outline-success py-0 px-2" title="Lập phiếu nhập sách này" aria-label="Nhập sách @item.Title">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

</div>

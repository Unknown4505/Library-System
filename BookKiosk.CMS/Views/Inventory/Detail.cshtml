@model ImportReceiptDetailDto
@{
    ViewData["Title"] = $"Chi tiết Phiếu nhập {Model.ReceiptNumber}";
}

<!-- Page Header & Actions -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 d-print-none">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Phiếu nhập kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.ReceiptNumber</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold text-dark">
            <i class="fas fa-file-invoice text-primary me-2"></i>Chi tiết Phiếu nhập @Model.ReceiptNumber
        </h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary px-3">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
        <button type="button" class="btn btn-outline-primary px-3" onclick="window.print()">
            <i class="fas fa-print me-1"></i> In phiếu
        </button>
    </div>
</div>

<!-- Receipt Info Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
    <div class="card-body p-4">
        <div class="row g-4">
            <!-- Thông tin phiếu -->
            <div class="col-md-6 col-lg-3 border-end">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Mã chứng từ</div>
                <h4 class="fw-bold text-primary font-monospace mb-1">@Model.ReceiptNumber</h4>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="fas fa-lock me-1"></i>Bất biến (Đã chốt kho)
                </span>
            </div>

            <!-- Nhà cung cấp -->
            <div class="col-md-6 col-lg-3 border-end">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Nhà cung cấp</div>
                <div class="fw-bold text-dark fs-6 mb-1">@Model.SupplierName</div>
                @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone))
                {
                    <div class="small text-muted font-monospace">
                        <i class="fas fa-phone-alt me-1 text-success"></i>@Model.SupplierPhone
                    </div>
                }
            </div>

            <!-- Thời gian & Người lập -->
            <div class="col-md-6 col-lg-3 border-end">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Thời gian lập phiếu</div>
                <div class="fw-bold text-dark mb-1">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small text-muted">
                    <i class="fas fa-user-check me-1"></i>Lập bởi: <strong>@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? $"User #{Model.UserId}" : Model.CreatedByName)</strong>
                </div>
            </div>

            <!-- Tổng tiền thanh toán -->
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Tổng tiền nhập kho</div>
                <h3 class="fw-bold text-success mb-0">@Model.TotalAmount.ToString("N0") ₫</h3>
                <small class="text-muted">Đã hạch toán vào giá vốn</small>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="mt-3 pt-3 border-top">
                <span class="fw-semibold text-secondary small me-2"><i class="fas fa-sticky-note text-warning me-1"></i>Ghi chú:</span>
                <span class="text-dark small">@Model.Note</span>
            </div>
        }
    </div>
</div>

<!-- Items Table Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="fas fa-list-ol text-primary me-2"></i>Danh mục ấn phẩm nhập kho
        </h6>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th class="ps-4" style="width: 50px;">STT</th>
                        <th style="width: 60px;">Bìa</th>
                        <th style="min-width: 250px;">Tựa đề sách & Tác giả</th>
                        <th>Mã vạch</th>
                        <th class="text-center" style="width: 120px;">Số lượng</th>
                        <th class="text-end" style="width: 150px;">Đơn giá nhập</th>
                        <th class="text-end pe-4" style="width: 180px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                        int totalQty = 0;
                    }
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            totalQty += item.Quantity;
                            <tr>
                                <td class="ps-4 text-muted fw-semibold">@(stt++)</td>
                                <td>
                                    <div class="rounded overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-light border" style="width: 40px; height: 54px;">
                                        <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "https://placehold.co/40x54/f8f9fa/6c757d?text=No+Img" : item.ImageUrl)" 
                                             alt="@item.Title" 
                                             style="max-width: 100%; max-height: 100%; object-fit: cover;" 
                                             onerror="this.onerror=null; this.src='https://placehold.co/40x54/f8f9fa/6c757d?text=No+Img';" />
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Author))
                                    {
                                        <small class="text-muted"><i class="fas fa-user-edit me-1"></i>@item.Author</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border small">
                                        <i class="fas fa-barcode me-1 text-secondary"></i>@item.Barcode
                                    </span>
                                </td>
                                <td class="text-center fw-bold text-dark fs-6">
                                    @item.Quantity
                                </td>
                                <td class="text-end text-secondary">
                                    @item.ImportPrice.ToString("N0") ₫
                                </td>
                                <td class="text-end pe-4 fw-bold text-success fs-6">
                                    @item.LineTotal.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="ps-4 fw-bold text-dark text-uppercase small">Tổng cộng</td>
                        <td class="text-center fw-bold fs-6 text-primary">@totalQty cuốn</td>
                        <td></td>
                        <td class="text-end pe-4 fw-bold fs-5 text-success">@Model.TotalAmount.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Chữ ký biên bản (Hiển thị khi in phiếu) -->
<div class="row g-4 mt-4 pt-3 text-center d-none d-print-flex">
    <div class="col-4">
        <div class="fw-bold text-dark mb-1">Người lập phiếu</div>
        <div class="text-muted small fst-italic mb-5">(Ký, họ tên)</div>
        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? "Nhân viên" : Model.CreatedByName)</div>
    </div>
    <div class="col-4">
        <div class="fw-bold text-dark mb-1">Đại diện giao hàng</div>
        <div class="text-muted small fst-italic mb-5">(Ký, họ tên)</div>
        <div class="fw-semibold">@Model.SupplierName</div>
    </div>
    <div class="col-4">
        <div class="fw-bold text-dark mb-1">Thủ kho nhận hàng</div>
        <div class="text-muted small fst-italic mb-5">(Ký, họ tên)</div>
        <div class="fw-semibold">Ban Quản lý Kho</div>
    </div>
</div>

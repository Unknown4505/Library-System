@model ReceiptListViewModel
@{
    ViewData["Title"] = "Quản lý Phiếu nhập kho";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold text-dark">
            <i class="fas fa-file-invoice text-primary me-2"></i>Quản lý Phiếu nhập kho
        </h1>
        <p class="text-muted small mb-0">Lịch sử các đợt nhập sách từ đối tác, số lượng ấn phẩm nhập và tổng chi phí đối soát.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Stock" class="btn btn-outline-secondary px-3">
            <i class="fas fa-warehouse me-1"></i> Xem tồn kho
        </a>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Lập phiếu nhập mới
        </a>
    </div>
</div>

<!-- Alert Thông báo -->
<partial name="_Alert" />

<!-- Filter Toolbar Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Lọc theo Nhà cung cấp -->
            <div class="col-md-4">
                <select name="supplierId" class="form-select bg-light">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <!option value="@s.SupplierId" @(Model.SupplierId == s.SupplierId ? "selected" : "")>
                            @s.Name
                        </!option>
                    }
                </select>
            </div>

            <!-- Từ ngày -->
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted small">Từ</span>
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
                </div>
            </div>

            <!-- Đến ngày -->
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted small">Đến</span>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="fas fa-filter me-1"></i> Lọc
                </button>
                @if (Model.SupplierId.HasValue || Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Đặt lại bộ lọc">
                        <i class="fas fa-redo"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Receipts Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: var(--bk-radius);">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0 fw-bold text-dark">Lịch sử phiếu nhập</h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                @Model.Receipts.TotalCount phiếu
            </span>
        </div>
        <div class="small text-muted">
            Hiển thị <strong>@Model.Receipts.Items.Count</strong> trên tổng số <strong>@Model.Receipts.TotalCount</strong> phiếu
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Receipts.Items == null || !Model.Receipts.Items.Any())
        {
            <partial name="_EmptyState" model='"Chưa có phiếu nhập kho nào phù hợp với bộ lọc tìm kiếm."' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4" style="width: 140px;">Mã phiếu</th>
                            <th style="min-width: 150px;">Thời gian lập</th>
                            <th>Nhà cung cấp</th>
                            <th>Người lập phiếu</th>
                            <th class="text-center">Số đầu sách</th>
                            <th class="text-end">Tổng tiền nhập</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4" style="width: 120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Receipts.Items)
                        {
                            <tr>
                                <!-- Mã phiếu -->
                                <td class="ps-4">
                                    <span class="fw-bold font-monospace text-primary">@r.ReceiptNumber</span>
                                </td>

                                <!-- Thời gian -->
                                <td>
                                    <div class="text-dark small fw-medium">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="text-muted small">@r.CreatedAt.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                </td>

                                <!-- Nhà cung cấp -->
                                <td>
                                    <div class="fw-bold text-dark">@r.SupplierName</div>
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        <small class="text-muted fst-italic">Ghi chú: @r.Notes</small>
                                    }
                                </td>

                                <!-- Người lập -->
                                <td>
                                    <div class="small text-secondary">
                                        <i class="fas fa-user-circle me-1"></i>@(string.IsNullOrWhiteSpace(r.CreatedByName) ? $"User #{r.UserId}" : r.CreatedByName)
                                    </div>
                                </td>

                                <!-- Số đầu sách & tổng cuốn -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(r.ItemCount > 0 ? r.ItemCount : 1) ấn phẩm
                                    </span>
                                </td>

                                <!-- Tổng tiền -->
                                <td class="text-end fw-bold text-success fs-6">
                                    @r.TotalAmount.ToString("N0") ₫
                                </td>

                                <!-- Trạng thái: Bất biến -->
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="fas fa-check-double me-1"></i>Đã nhập kho
                                    </span>
                                </td>

                                <!-- Thao tác -->
                                <td class="text-end pe-4">
                                    <a asp-action="Detail" asp-route-id="@r.ImportReceiptId" class="btn btn-sm btn-outline-primary" title="Xem chi tiết phiếu nhập">
                                        <i class="fas fa-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            <div class="p-3 border-top">
                <partial name="_Pagination" model="Model.Receipts" />
            </div>
        }
    </div>
</div>

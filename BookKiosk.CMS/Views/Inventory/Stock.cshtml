@model StockListViewModel
@{
    ViewData["Title"] = "Giám sát Tồn kho & Kiểm kê";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold text-dark">
            <i class="fas fa-boxes text-primary me-2"></i>Giám sát Tồn kho & Kiểm kê
        </h1>
        <p class="text-muted small mb-0">Theo dõi tồn thực tế, hàng đang giữ chỗ tại quầy/Kiosk và thực hiện điều chỉnh kiểm kê.</p>
    </div>
    <div>
        <a href="/Inventory/Create" class="btn btn-primary px-3 shadow-sm">
            <i class="fas fa-dolly-flatbed me-1"></i> Lập phiếu nhập kho
        </a>
    </div>
</div>

<!-- Alert Thông báo -->
<partial name="_Alert" />

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Tổng đầu sách -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--bk-radius);">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fas fa-book fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Đầu sách trong kho</div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.TotalItems</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng số lượng cuốn tồn -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--bk-radius);">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info-subtle text-info p-3 me-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fas fa-warehouse fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng số cuốn tồn</div>
                    <h4 class="mb-0 fw-bold text-dark">@Model.TotalStockQuantity.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Cảnh báo sắp hết hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--bk-radius);">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-warning-subtle text-warning p-3 me-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fas fa-exclamation-triangle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Sắp hết (≤ 5 cuốn)</div>
                    <h4 class="mb-0 fw-bold text-warning">@Model.LowStockCount</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Đã hết hàng -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius: var(--bk-radius);">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-danger-subtle text-danger p-3 me-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fas fa-times-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Đã hết hàng (0)</div>
                    <h4 class="mb-0 fw-bold text-danger">@Model.OutOfStockCount</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Toolbar Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
    <div class="card-body p-3">
        <form method="get" asp-action="Stock" class="row g-2 align-items-center">
            <!-- Tìm kiếm từ khóa -->
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control bg-light border-start-0" 
                           placeholder="Tìm theo tên sách, tác giả, mã vạch..." />
                </div>
            </div>

            <!-- Checkbox lọc tồn thấp -->
            <div class="col-md-4">
                <div class="form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" name="lowOnly" value="true" id="lowOnlySwitch" 
                           @(Model.LowOnly ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label fw-semibold text-dark small" for="lowOnlySwitch">
                        <i class="fas fa-filter text-warning me-1"></i>Chỉ xem sách sắp hết / hết hàng
                    </label>
                </div>
            </div>

            <!-- Nút lọc & Reset -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="fas fa-search me-1"></i> Tra cứu
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.LowOnly)
                {
                    <a asp-action="Stock" class="btn btn-outline-secondary px-3" title="Đặt lại bộ lọc">
                        <i class="fas fa-redo"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Stock Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: var(--bk-radius);">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0 fw-bold text-dark">Dữ liệu kiểm kê kho</h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                @Model.TotalItems bản ghi
            </span>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.StockItems == null || !Model.StockItems.Any())
        {
            <partial name="_EmptyState" model='"Không tìm thấy đầu sách nào theo tiêu chí tồn kho hiện tại."' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4" style="width: 60px;">Bìa</th>
                            <th style="min-width: 240px;">Ấn phẩm & Mã vạch</th>
                            <th>Khu vực kệ</th>
                            <th class="text-center" style="width: 120px;">Tồn vật lý</th>
                            <th class="text-center" style="width: 120px;">Đang giữ</th>
                            <th class="text-center" style="width: 150px;">Khả dụng bán</th>
                            <th class="text-end pe-4" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.StockItems)
                        {
                            <tr>
                                <!-- Bìa sách -->
                                <td class="ps-4">
                                    <div class="rounded overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-light border" 
                                         style="width: 44px; height: 60px;">
                                        <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "https://placehold.co/44x60/f8f9fa/6c757d?text=No+Img" : item.ImageUrl)" 
                                             alt="@item.Title" 
                                             style="max-width: 100%; max-height: 100%; object-fit: cover;" 
                                             onerror="this.onerror=null; this.src='https://placehold.co/44x60/f8f9fa/6c757d?text=No+Img';" />
                                    </div>
                                </td>

                                <!-- Thông tin sách -->
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-user-edit me-1"></i>@item.Author
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-light text-dark font-monospace border small">
                                            <i class="fas fa-barcode me-1 text-secondary"></i>@item.Barcode
                                        </span>
                                    </div>
                                </td>

                                <!-- Vị trí kệ -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.AreaName))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                            <i class="fas fa-map-marker-alt me-1"></i>@item.AreaName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Chưa xếp kệ</span>
                                    }
                                </td>

                                <!-- Tồn thực tế (Stock) -->
                                <td class="text-center fw-bold text-dark fs-6">
                                    @item.StockQuantity
                                </td>

                                <!-- Đang giữ chỗ (Reserved) -->
                                <td class="text-center">
                                    @if (item.ReservedQuantity > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            @item.ReservedQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>

                                <!-- Khả dụng bán (Available) -->
                                <td class="text-center">
                                    @if (item.AvailableStock <= 0)
                                    {
                                        <span class="badge bg-danger text-white px-2 py-1">
                                            <i class="fas fa-times-circle me-1"></i>Hết hàng (0)
                                        </span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">
                                            <i class="fas fa-exclamation-circle me-1"></i>Sắp hết (@item.AvailableStock)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="fas fa-check-circle me-1"></i>Còn @item.AvailableStock cuốn
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-primary" title="Kiểm kê / Điều chỉnh tồn"
                                                onclick="openAdjustStockModal(@item.BookId, '@Html.Raw(Html.Encode(item.Title))', @item.StockQuantity, @item.ReservedQuantity)">
                                            <i class="fas fa-sliders-h me-1"></i>Kiểm kê
                                        </button>
                                        <a href="/Inventory/Create" class="btn btn-outline-success" title="Lập phiếu nhập thêm">
                                            <i class="fas fa-plus"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL: ĐIỀU CHỈNH KIỂM KÊ KHO -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: var(--bk-radius);">
            <form asp-controller="Inventory" asp-action="Adjust" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="adjustBookId" name="BookId" />

                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="adjustStockModalLabel">
                        <i class="fas fa-sliders-h text-primary me-2"></i>Điều chỉnh Kiểm kê kho
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Tên sách kiểm kê</label>
                        <div id="adjustBookTitle" class="fw-bold text-dark fs-6 bg-light p-2 rounded border"></div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small mb-1">Tồn hệ thống ghi nhận</label>
                            <input type="text" id="adjustCurrentStock" class="form-control bg-light fw-bold text-center" readonly />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small mb-1">Đang giữ chỗ tại POS/Kiosk</label>
                            <input type="text" id="adjustReservedStock" class="form-control bg-light text-center" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Số lượng tồn thực tế đếm được <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="adjustActualQuantity" name="ActualQuantity" min="0" class="form-control form-control-lg text-center fw-bold" required />
                        <div id="adjustDifferenceNotice" class="small mt-1 text-center fw-semibold"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">
                            Lý do điều chỉnh (Bắt buộc) <span class="text-danger">*</span>
                        </label>
                        <textarea name="Reason" class="form-control" rows="3" 
                                  placeholder="Ví dụ: Kiểm kê định kỳ tháng 10, Sách rách/hỏng thanh lý, Thất thoát do quét sót..." 
                                  required maxlength="500"></textarea>
                    </div>

                    <div class="alert alert-warning py-2 px-3 small mb-0 border-0 bg-warning-subtle text-warning-emphasis">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <strong>Cảnh báo:</strong> Hành động này sẽ thay đổi trực tiếp số lượng tồn kho của hệ thống và được lưu vết kiểm toán nội bộ.
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-check me-1"></i> Xác nhận điều chỉnh
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSystemStock = 0;

        function openAdjustStockModal(bookId, title, currentStock, reservedStock) {
            document.getElementById('adjustBookId').value = bookId;
            document.getElementById('adjustBookTitle').innerText = title;
            document.getElementById('adjustCurrentStock').value = currentStock + ' cuốn';
            document.getElementById('adjustReservedStock').value = reservedStock + ' cuốn';

            currentSystemStock = currentStock;
            const actualInput = document.getElementById('adjustActualQuantity');
            actualInput.value = currentStock;

            updateDifference(currentStock);

            const modal = new bootstrap.Modal(document.getElementById('adjustStockModal'));
            modal.show();
        }

        document.getElementById('adjustActualQuantity')?.addEventListener('input', function (e) {
            const actualVal = parseInt(e.target.value) || 0;
            updateDifference(actualVal);
        });

        function updateDifference(actualVal) {
            const diff = actualVal - currentSystemStock;
            const diffNotice = document.getElementById('adjustDifferenceNotice');
            if (!diffNotice) return;

            if (diff > 0) {
                diffNotice.innerHTML = '<span class="text-success"><i class="fas fa-arrow-up me-1"></i>Thừa ' + diff + ' cuốn so với hệ thống</span>';
            } else if (diff < 0) {
                diffNotice.innerHTML = '<span class="text-danger"><i class="fas fa-arrow-down me-1"></i>Thiếu ' + Math.abs(diff) + ' cuốn so với hệ thống</span>';
            } else {
                diffNotice.innerHTML = '<span class="text-muted"><i class="fas fa-check me-1"></i>Khớp hoàn toàn với hệ thống</span>';
            }
        }
    </script>
}

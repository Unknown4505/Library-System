@model BookKiosk.CMS.ViewModels.Orders.OrderDetailViewModel
@using BookKiosk.CMS.Models.Api.Orders

@{
    var order = Model.Order;
    var orderTitle = !string.IsNullOrWhiteSpace(order?.OrderCode) ? order.OrderCode : "Chi tiết";
}

<div class="modal-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
    <h5 class="modal-title fs-6 fw-bold text-dark mb-0">
        <i class="fas fa-file-invoice text-primary me-2"></i>Chi tiết đơn hàng: <span class="font-monospace text-primary">@orderTitle</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<div class="modal-body p-3">
    <partial name="_OrderDetailContent" model="Model" />
</div>

<div class="modal-footer justify-content-between py-2 px-3 bg-light border-top">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i>Đóng
    </button>
    <div class="d-flex gap-2">
        @if (order != null && order.SaleChannel == SaleChannel.Counter && order.OrderStatus == OrderStatus.Pending)
        {
            <form asp-action="CancelCounterOrder" asp-route-id="@order.OrderId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này và nhả kho giữ chỗ?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="fas fa-ban me-1"></i>Hủy đơn hàng
                </button>
            </form>
        }

        @if (order != null && order.OrderStatus == OrderStatus.Paid)
        {
            <button type="button" class="btn btn-primary btn-sm fw-semibold btn-print-from-detail" data-order-id="@order.OrderId">
                <i class="fas fa-print me-1"></i>In lại hóa đơn K80
            </button>
        }
    </div>
</div>

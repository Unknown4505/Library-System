@model BookKiosk.CMS.ViewModels.Orders.OrderDetailViewModel
@using BookKiosk.CMS.Helpers
@using BookKiosk.CMS.Models.Api.Orders

@{
    var order = Model.Order;
    decimal totalPaid = order.Payments?.Sum(p => p.Amount) ?? 0m;
    decimal discrepancy = order.TotalAmount - totalPaid;
}

<div class="modal-header bg-light py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
    <h5 class="modal-title fs-6 fw-bold text-dark mb-0">
        <i class="fas fa-file-invoice text-primary me-2"></i>Chi tiết đơn hàng: <span class="font-monospace text-primary">@order.OrderCode</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<div class="modal-body p-3">
    @if (Model.IsEndpointUnavailable)
    {
        <div class="alert alert-warning border-warning-subtle small mb-3">
            <i class="fas fa-exclamation-triangle me-1"></i>
            <strong>Endpoint chưa sẵn sàng:</strong> @Model.EndpointMessage
        </div>
    }

    <!-- 1. BẢNG CẢNH BÁO ĐỐI SOÁT LỆCH TIỀN (NẾU CÓ) -->
    @if (order.IsPaymentMismatch)
    {
        <div class="reconciliation-card shadow-sm mb-3">
            <div class="d-flex align-items-center mb-2">
                <i class="fas fa-exclamation-circle text-danger fs-5 me-2"></i>
                <div class="reconciliation-title mb-0">CẢNH BÁO ĐỐI SOÁT: SỐ TIỀN CHUYỂN KHOẢN KHÔNG KHỚP</div>
            </div>
            <p class="small text-muted mb-2">
                Giao dịch ngân hàng ghi nhận số tiền chuyển khoản không khớp với tổng tiền đơn hàng. 
                Theo quy định bảo mật & SLA: Nhân viên đối soát tài khoản và xử lý trong ngày.
            </p>
            <div class="row g-2 text-center">
                <div class="col-4">
                    <div class="reconciliation-stat-box">
                        <div class="reconciliation-stat-label">Cần thanh toán</div>
                        <div class="reconciliation-stat-val text-dark">@MoneyHelper.FormatVnd(order.TotalAmount)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="reconciliation-stat-box">
                        <div class="reconciliation-stat-label">Thực nhận (SePay)</div>
                        <div class="reconciliation-stat-val text-primary">@MoneyHelper.FormatVnd(totalPaid)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="reconciliation-stat-box">
                        <div class="reconciliation-stat-label">Chênh lệch</div>
                        <div class="reconciliation-stat-val @(discrepancy > 0 ? "text-danger" : "text-success")">
                            @(discrepancy > 0 ? $"-{MoneyHelper.FormatVnd(discrepancy)}" : $"+{MoneyHelper.FormatVnd(Math.Abs(discrepancy))}")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 2. THÔNG TIN CHUNG ĐƠN HÀNG -->
    <div class="card mb-3 border-light shadow-sm bg-light">
        <div class="card-body p-3">
            <div class="row g-2 small">
                <div class="col-sm-6">
                    <div><span class="text-muted">Kênh bán hàng:</span> 
                        @if (order.SaleChannel == SaleChannel.Kiosk)
                        {
                            <span class="badge badge-channel-kiosk ms-1"><i class="fas fa-desktop me-1"></i>Kiosk tự phục vụ</span>
                        }
                        else
                        {
                            <span class="badge badge-channel-counter ms-1"><i class="fas fa-cash-register me-1"></i>Bán tại quầy</span>
                        }
                    </div>
                    <div class="mt-1"><span class="text-muted">Thời gian tạo:</span> <strong>@DateTimeHelper.FormatVietnamDateTime(order.CreatedAt)</strong></div>
                    <div class="mt-1"><span class="text-muted">Thời gian hoàn tất:</span> <strong>@DateTimeHelper.FormatVietnamDateTime(order.CompletedAt)</strong></div>
                    <div class="mt-1"><span class="text-muted">Người lập / Phụ trách:</span> <span>@(order.CashierName ?? "Thu ngân")</span></div>
                </div>
                <div class="col-sm-6">
                    <div><span class="text-muted">Trạng thái đơn:</span>
                        @if (order.OrderStatus == OrderStatus.Paid)
                        {
                            <span class="badge badge-status-paid ms-1"><i class="fas fa-check-circle me-1"></i>Đã thanh toán</span>
                        }
                        else if (order.OrderStatus == OrderStatus.Pending)
                        {
                            <span class="badge badge-status-pending ms-1"><i class="fas fa-clock me-1"></i>Chờ thanh toán</span>
                        }
                        else
                        {
                            <span class="badge badge-status-cancelled ms-1"><i class="fas fa-times-circle me-1"></i>Đã hủy</span>
                        }
                    </div>
                    <div class="mt-1"><span class="text-muted">Phương thức thanh toán:</span> <strong>@(order.PaymentMethod == PaymentMethod.QR ? "Chuyển khoản QR" : "Tiền mặt")</strong></div>
                    <div class="mt-1"><span class="text-muted">Khách hàng thành viên:</span> 
                        @if (!string.IsNullOrWhiteSpace(order.MemberName))
                        {
                            <strong>@order.MemberName</strong>
                            @if (!string.IsNullOrWhiteSpace(order.MemberPhone))
                            {
                                <span class="text-muted font-monospace ms-1">(@PhoneHelper.MaskPhone(order.MemberPhone))</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Khách vãng lai</span>
                        }
                    </div>
                    @if (order.PointsEarned.HasValue && order.PointsEarned.Value > 0)
                    {
                        <div class="mt-1"><span class="text-muted">Điểm tích lũy nhận được:</span> <strong class="text-success">+@order.PointsEarned.Value điểm</strong></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 3. DANH SÁCH SẢN PHẨM (SNAPSHOT TẠI THỜI ĐIỂM BÁN) -->
    <h6 class="fw-bold text-dark fs-6 mb-2">
        <i class="fas fa-book text-secondary me-1"></i>Danh sách sách trong đơn hàng:
    </h6>
    <div class="table-responsive mb-3 border rounded shadow-sm">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead class="table-light small">
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th>Tên sách (Snapshot)</th>
                    <th class="text-center" style="width: 80px;">SL</th>
                    <th class="text-end" style="width: 120px;">Đơn giá</th>
                    <th class="text-end" style="width: 140px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (order.Items != null && order.Items.Any())
                {
                    int idx = 1;
                    foreach (var item in order.Items)
                    {
                        <tr>
                            <td class="text-center text-muted">@idx</td>
                            <td>
                                <span class="fw-semibold text-dark">@item.BookTitle</span>
                                <span class="small text-muted font-monospace d-block">ID: #@item.BookId</span>
                            </td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end font-monospace">@MoneyHelper.FormatVnd(item.UnitPriceAtTime)</td>
                            <td class="text-end font-monospace fw-bold">@MoneyHelper.FormatVnd(item.LineTotal)</td>
                        </tr>
                        idx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-3 text-muted">Không có thông tin chi tiết sản phẩm.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 4. TỔNG HỢP TIỀN -->
    <div class="row justify-content-end mb-3">
        <div class="col-md-6 col-lg-5">
            <div class="bg-light p-3 rounded border small">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tạm tính (niêm yết):</span>
                    <span class="font-monospace">@MoneyHelper.FormatVnd(order.SubTotal)</span>
                </div>
                @if (order.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success mb-1">
                        <span>Giảm khuyến mãi @(!string.IsNullOrWhiteSpace(order.PromotionName) ? $"({order.PromotionName})" : ""):</span>
                        <span class="font-monospace">-@MoneyHelper.FormatVnd(order.DiscountAmount)</span>
                    </div>
                }
                @if (order.PointsUsedAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success mb-1">
                        <span>Trừ điểm (@order.PointsUsed điểm):</span>
                        <span class="font-monospace">-@MoneyHelper.FormatVnd(order.PointsUsedAmount)</span>
                    </div>
                }
                <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center">
                    <strong class="text-dark fs-6">THỰC TRẢ:</strong>
                    <strong class="text-danger fs-5 font-monospace">@MoneyHelper.FormatVnd(order.TotalAmount)</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. LỊCH SỬ GIAO DỊCH THANH TOÁN (PAYMENT TRANSACTIONS) -->
    <h6 class="fw-bold text-dark fs-6 mb-2">
        <i class="fas fa-history text-secondary me-1"></i>Lịch sử giao dịch thanh toán / Webhook SePay:
    </h6>
    @if (order.Payments != null && order.Payments.Any())
    {
        <div class="table-responsive border rounded shadow-sm mb-2">
            <table class="table table-sm table-striped mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Cổng thanh toán</th>
                        <th>Mã tham chiếu (RefCode)</th>
                        <th>Thời gian giao dịch</th>
                        <th class="text-end">Số tiền ghi nhận</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in order.Payments)
                    {
                        <tr>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@p.Gateway</span></td>
                            <td class="font-monospace fw-bold">@p.ReferenceCode</td>
                            <td>@DateTimeHelper.FormatVietnamDateTime(p.CreatedAt)</td>
                            <td class="text-end font-monospace fw-bold text-success">@MoneyHelper.FormatVnd(p.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-light border small text-muted mb-2">
            <i class="fas fa-info-circle me-1"></i>Chưa ghi nhận giao dịch thanh toán điện tử nào cho đơn hàng này.
        </div>
    }

    <!-- 6. LƯU Ý BẢO MẬT & QUYỀN HẠN TỪ TECH LEAD -->
    @if (order.SaleChannel == SaleChannel.Kiosk)
    {
        <div class="small bg-white p-2 rounded border border-secondary-subtle text-secondary mt-3">
            <i class="fas fa-shield-alt text-primary me-1"></i>
            <strong>Quy định nghiệp vụ Kiosk:</strong> Hệ thống hiện tại chỉ hỗ trợ xem và đối soát đối với đơn hàng Kiosk. Backend chưa hỗ trợ route hủy đơn Kiosk cho nhân viên để đảm bảo an toàn kho hàng.
        </div>
    }
</div>

<div class="modal-footer justify-content-between py-2 px-3 bg-light border-top">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
        <i class="fas fa-times me-1"></i>Đóng
    </button>
    <div class="d-flex gap-2">
        @if (order.OrderStatus == OrderStatus.Paid)
        {
            <button type="button" class="btn btn-primary btn-sm fw-semibold btn-print-from-detail" data-order-id="@order.OrderId">
                <i class="fas fa-print me-1"></i>In lại hóa đơn K80
            </button>
        }
    </div>
</div>

@model BookFormViewModel
@{
    ViewData["Title"] = "Thêm sách mới";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý Sách</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold text-dark">
            <i class="fas fa-plus-circle text-primary me-2"></i>Thêm sách mới vào Catalog
        </h1>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<!-- Alert Thông báo -->
<partial name="_Alert" />

<!-- Form Thêm mới -->
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_BookForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Quản lý Sách";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4 mt-3">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-book text-primary me-2"></i> Quản lý Sách</h1>
    <a href="/Books/Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Thêm sách mới
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách các đầu sách trong kho</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover" id="booksTable" width="100%" cellspacing="0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Ảnh bìa</th>
                        <th>Tên Sách</th>
                        <th>Mã Vạch</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Dữ liệu sẽ được load bằng Ajax DataTables -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Đã thay đổi API Backend port thành 7111
            const apiUrl = 'https://localhost:7111/api/books';
            
            $('#booksTable').DataTable({
                "ajax": {
                    "url": apiUrl,
                    "type": "GET",
                    "dataSrc": "data" // Vì API trả về BaseResponse có chứa thuộc tính Data
                },
                "columns": [
                    { "data": "bookId" },
                    { 
                        "data": "imageUrl",
                        "render": function(data, type, row) {
                            var imgUrl = data ? 'https://localhost:7111' + data : 'https://via.placeholder.com/50x70?text=No+Image';
                            return '<img src="' + imgUrl + '" style="height: 70px; object-fit: cover;" class="rounded shadow-sm" />';
                        }
                    },
                    { "data": "title", "className": "fw-bold" },
                    { "data": "barcode" },
                    { 
                        "data": "sellingPrice",
                        "render": function(data) {
                            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(data);
                        }
                    },
                    { 
                        "data": "stockQuantity",
                        "render": function(data) {
                            if (data <= 5) return '<span class="badge bg-danger">Sắp hết (' + data + ')</span>';
                            return '<span class="badge bg-success">' + data + '</span>';
                        }
                    },
                    { 
                        "data": "isActive",
                        "render": function(data) {
                            return data ? '<span class="badge bg-primary">Đang bán</span>' : '<span class="badge bg-secondary">Ngừng bán</span>';
                        }
                    },
                    {
                        "data": "bookId",
                        "render": function(data, type, row) {
                            return `
                                <a href="/Books/Edit/${data}" class="btn btn-warning btn-sm" title="Sửa"><i class="fas fa-edit"></i></a>
                                <button onclick="deleteBook(${data})" class="btn btn-danger btn-sm" title="Xóa"><i class="fas fa-trash"></i></button>
                            `;
                        },
                        "orderable": false,
                        "searchable": false
                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json" // Việt hóa
                }
            });
        });

        function deleteBook(id) {
            if(confirm('Bạn có chắc chắn muốn xóa sách ID ' + id + ' không?')) {
                $.ajax({
                    url: 'https://localhost:7111/api/books/' + id,
                    type: 'DELETE',
                    success: function() {
                        alert('Xóa thành công!');
                        $('#booksTable').DataTable().ajax.reload();
                    },
                    error: function() {
                        alert('Xóa thất bại! Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
}

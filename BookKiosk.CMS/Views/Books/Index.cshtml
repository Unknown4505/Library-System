@model BookListViewModel
@{
    ViewData["Title"] = "Quản lý Sách";
    bool isAdmin = User.IsInRole("Admin");
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold text-dark">
            <i class="fas fa-book text-primary me-2"></i>Quản lý Sách (Catalog)
        </h1>
        <p class="text-muted small mb-0">Tra cứu, cập nhật thông tin ấn phẩm, số lượng tồn kho, giá bán và vị trí kệ sách.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Thêm sách mới
        </a>
    </div>
</div>

<!-- Alert Thông báo -->
<partial name="_Alert" />

<!-- Filter Toolbar Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Tìm kiếm từ khóa -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control bg-light border-start-0" 
                           placeholder="Tìm theo tên, tác giả, mã vạch..." />
                </div>
            </div>

            <!-- Lọc theo Danh mục -->
            <div class="col-md-3">
                <select name="categoryId" class="form-select bg-light">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <!option value="@cat.CategoryId" @(Model.CategoryId == cat.CategoryId ? "selected" : "")>
                            @cat.Name
                        </!option>
                    }
                </select>
            </div>

            <!-- Lọc theo Khu vực / Kệ sách -->
            <div class="col-md-3">
                <select name="areaId" class="form-select bg-light">
                    <option value="">-- Tất cả khu vực / kệ --</option>
                    @foreach (var area in Model.Areas)
                    {
                        <!option value="@area.AreaId" @(Model.AreaId == area.AreaId ? "selected" : "")>
                            @area.Name
                        </!option>
                    }
                </select>
            </div>

            <!-- Nút hành động lọc -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3 flex-grow-1">
                    <i class="fas fa-filter me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.CategoryId.HasValue || Model.AreaId.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Xóa bộ lọc">
                        <i class="fas fa-redo"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Books List Card -->
<div class="card border-0 shadow-sm" style="border-radius: var(--bk-radius);">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0 fw-bold text-dark">Danh sách ấn phẩm</h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-2">
                @Model.Books.TotalCount cuốn
            </span>
        </div>
        <div class="small text-muted">
            Hiển thị <strong>@Model.Books.Items.Count</strong> trên tổng số <strong>@Model.Books.TotalCount</strong> bản ghi
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Books.Items == null || !Model.Books.Items.Any())
        {
            <partial name="_EmptyState" model='"Không tìm thấy ấn phẩm nào phù hợp với điều kiện tìm kiếm."' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4" style="width: 70px;">Bìa</th>
                            <th style="min-width: 250px;">Tựa đề & Tác giả</th>
                            <th>Phân loại & Kệ</th>
                            <th>Đơn giá</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books.Items)
                        {
                            <tr>
                                <!-- Bìa sách -->
                                <td class="ps-4">
                                    <div class="rounded overflow-hidden shadow-sm d-flex align-items-center justify-content-center bg-light border" 
                                         style="width: 50px; height: 68px;">
                                        <img src="@(string.IsNullOrWhiteSpace(book.ImageUrl) ? "https://placehold.co/50x68/f8f9fa/6c757d?text=No+Img" : book.ImageUrl)" 
                                             alt="@book.Title" 
                                             style="max-width: 100%; max-height: 100%; object-fit: cover;" 
                                             onerror="this.onerror=null; this.src='https://placehold.co/50x68/f8f9fa/6c757d?text=No+Img';" />
                                    </div>
                                </td>

                                <!-- Tựa đề & Tác giả -->
                                <td>
                                    <div class="fw-bold text-dark mb-1">@book.Title</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-user-edit me-1"></i>@book.Author
                                        @if (!string.IsNullOrWhiteSpace(book.Publisher))
                                        {
                                            <span> • @book.Publisher</span>
                                        }
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-light text-dark font-monospace border small">
                                            <i class="fas fa-barcode me-1 text-secondary"></i>@book.Barcode
                                        </span>
                                    </div>
                                </td>

                                <!-- Phân loại & Kệ -->
                                <td>
                                    <div class="mb-1">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="fas fa-bookmark me-1"></i>@book.CategoryName
                                        </span>
                                    </div>
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(book.AreaName))
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                <i class="fas fa-map-marker-alt me-1"></i>@book.AreaName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">
                                                <i class="fas fa-box me-1"></i>Chưa xếp kệ
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Đơn giá -->
                                <td>
                                    <div class="fw-bold text-primary">@book.SellingPrice.ToString("N0") ₫</div>
                                    <small class="text-muted" title="Giá nhập">Vốn: @book.CostPrice.ToString("N0") ₫</small>
                                </td>

                                <!-- Tồn kho -->
                                <td>
                                    @if (book.AvailableStock > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1">
                                            <i class="fas fa-check me-1"></i>Còn @book.AvailableStock cuốn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                            <i class="fas fa-times-circle me-1"></i>Hết hàng (0)
                                        </span>
                                    }
                                    <div class="text-muted small mt-1">Tổng tồn: @book.StockQuantity | Giữ: @book.ReservedQuantity</div>
                                </td>

                                <!-- Trạng thái -->
                                <td>
                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success text-white">
                                            <i class="fas fa-eye me-1"></i>Kinh doanh
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white">
                                            <i class="fas fa-eye-slash me-1"></i>Đã ẩn
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Nút Sửa: Cả Admin và Staff đều có quyền -->
                                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-primary" title="Chỉnh sửa sách">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- Nút Ẩn sách: ROLE GATING - CHỈ HIỂN THỊ VỚI ADMIN -->
                                        @if (isAdmin)
                                        {
                                            @if (book.IsActive)
                                            {
                                                <button type="button" class="btn btn-outline-danger" title="Ẩn sách khỏi hệ thống"
                                                        onclick="confirmHideBook(@book.BookId, '@Html.Raw(Html.Encode(book.Title))')">
                                                    <i class="fas fa-eye-slash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-secondary" disabled title="Sách đã được ẩn">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang kế thừa từ Tuần 1 -->
            <div class="p-3 border-top">
                <partial name="_Pagination" model="Model.Books" />
            </div>
        }
    </div>
</div>

<!-- Modal xác nhận thao tác kế thừa từ Tuần 1 -->
<partial name="_ConfirmModal" />

@section Scripts {
    <script>
        // Kích hoạt Modal Xác nhận Ẩn sách (Soft Delete)
        function confirmHideBook(id, title) {
            showConfirmModal(
                '/Books/Delete/' + id,
                'Bạn có chắc chắn muốn ẩn cuốn sách "' + title + '" khỏi hệ thống không? Sách bị ẩn sẽ không hiển thị trên Kiosk tra cứu và màn hình Bán hàng (POS).',
                'Xác nhận ẩn',
                'btn-danger'
            );
        }
    </script>
}

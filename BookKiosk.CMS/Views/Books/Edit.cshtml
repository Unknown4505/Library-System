@model BookFormViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa: {Model.Title}";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý Sách</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa #@Model.BookId</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0 fw-bold text-dark">
            <i class="fas fa-edit text-primary me-2"></i>Chỉnh sửa thông tin sách
        </h1>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary px-3">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<!-- Alert Thông báo -->
<partial name="_Alert" />

<!-- Form Cập nhật -->
<form asp-action="Edit" asp-route-id="@Model.BookId" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BookId" />
    <partial name="_BookForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

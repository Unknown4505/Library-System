@model BookFormViewModel
@{
    bool isAdmin = User.IsInRole("Admin");
}

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN CHI TIẾT SÁCH -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="fas fa-info-circle text-primary me-2"></i>Thông tin cơ bản
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- Barcode -->
                    <div class="col-md-6">
                        <label asp-for="Barcode" class="form-label fw-semibold text-secondary">
                            Mã vạch (Barcode / ISBN) <span class="text-danger">*</span>
                        </label>
                        @if (Model.IsEditMode)
                        {
                            <input asp-for="Barcode" class="form-control font-monospace bg-light" readonly />
                            <small class="text-muted"><i class="fas fa-lock me-1"></i>Mã định danh không thể thay đổi sau khi tạo.</small>
                        }
                        else
                        {
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fas fa-barcode"></i></span>
                                <input asp-for="Barcode" class="form-control font-monospace" placeholder="Quét hoặc nhập mã vạch..." required maxlength="50" />
                            </div>
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        }
                    </div>

                    <!-- Tên sách -->
                    <div class="col-md-12">
                        <label asp-for="Title" class="form-label fw-semibold text-secondary">
                            Tên sách <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tựa đề sách đầy đủ..." required maxlength="255" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Tác giả & Nhà xuất bản -->
                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-semibold text-secondary">
                            Tác giả <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Author" class="form-control" placeholder="Tên tác giả hoặc nhóm dịch giả..." required maxlength="255" />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Publisher" class="form-label fw-semibold text-secondary">Nhà xuất bản</label>
                        <input asp-for="Publisher" class="form-control" placeholder="Ví dụ: NXB Trẻ, NXB Kim Đồng..." maxlength="255" />
                        <span asp-validation-for="Publisher" class="text-danger small"></span>
                    </div>

                    <!-- Danh mục & Khu vực kệ -->
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold text-secondary">
                            Thể loại danh mục <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select" required>
                            <option value="">-- Chọn thể loại --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AreaId" class="form-label fw-semibold text-secondary">Khu vực / Kệ sách</label>
                        <select asp-for="AreaId" asp-items="Model.AreaOptions" class="form-select">
                            <option value="">-- Chưa xếp kệ (Kho dự trữ) --</option>
                        </select>
                        <small class="text-muted">Vị trí thực tế trên sàn Kiosk tra cứu.</small>
                    </div>

                    <!-- Giá nhập & Giá bán -->
                    <div class="col-md-6">
                        <label asp-for="CostPrice" class="form-label fw-semibold text-secondary">
                            Giá nhập (VNĐ) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="CostPrice" type="number" step="1000" min="0" class="form-control" required />
                            <span class="input-group-text bg-light text-muted">₫</span>
                        </div>
                        <span asp-validation-for="CostPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SellingPrice" class="form-label fw-semibold text-secondary">
                            Giá bán niêm yết (VNĐ) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="SellingPrice" type="number" step="1000" min="0" class="form-control" required />
                            <span class="input-group-text bg-light text-muted">₫</span>
                        </div>
                        <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: BÌA SÁCH, TỒN KHO & TRẠNG THÁI -->
    <div class="col-lg-4">
        <!-- Card Hình ảnh bìa -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="fas fa-image text-primary me-2"></i>Bìa sách
                </h6>
            </div>
            <div class="card-body p-4 text-center">
                <div class="book-cover-preview-wrapper mb-3 mx-auto shadow-sm rounded overflow-hidden d-flex align-items-center justify-content-center bg-light border" 
                     style="width: 140px; height: 190px;">
                    <img id="bookCoverImg" 
                         src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/default-book.png" : Model.ImageUrl)" 
                         alt="Preview bìa sách" 
                         style="max-width: 100%; max-height: 100%; object-fit: cover;" 
                         onerror="this.onerror=null; this.src='https://placehold.co/140x190/f8f9fa/6c757d?text=No+Cover';" />
                </div>
                <div class="mb-0 text-start">
                    <label asp-for="ImageUrl" class="form-label fw-semibold text-secondary small">URL hình ảnh</label>
                    <input asp-for="ImageUrl" id="bookImageUrlInput" class="form-control form-control-sm" placeholder="https://... hoặc /uploads/..." maxlength="500" />
                    <small class="text-muted d-block mt-1">Dán liên kết ảnh bìa trực tiếp để xem trước tức thì.</small>
                </div>
            </div>
        </div>

        <!-- Card Quản lý Tồn kho -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: var(--bk-radius);">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold text-dark">
                    <i class="fas fa-warehouse text-primary me-2"></i>Quản lý Tồn kho
                </h6>
            </div>
            <div class="card-body p-4">
                @if (Model.IsEditMode)
                {
                    <!-- Khi chỉnh sửa: Khóa ô tồn kho, chỉ đọc theo nghiệp vụ Phân hệ D & E -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Tồn kho thực tế (Stock)</label>
                        <input asp-for="StockQuantity" class="form-control bg-light fw-bold" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Đang giữ chỗ (Reserved)</label>
                        <input asp-for="ReservedQuantity" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Khả dụng bán (Available)</label>
                        <div class="form-control bg-light text-success fw-bold">@Model.AvailableStock cuốn</div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small mb-0 border-0 bg-info-subtle text-info-emphasis">
                        <i class="fas fa-info-circle me-1"></i>
                        <strong>Lưu ý:</strong> Số lượng tồn kho chỉ được điều chỉnh tự động thông qua <strong>Phân hệ Nhập kho</strong> hoặc <strong>Kiểm kê</strong>.
                    </div>
                }
                else
                {
                    <!-- Khi thêm mới: Cho phép nhập số lượng ban đầu -->
                    <div class="mb-3">
                        <label asp-for="StockQuantity" class="form-label fw-semibold text-secondary small">
                            Số lượng tồn kho ban đầu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="StockQuantity" type="number" min="0" class="form-control" required />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Số lượng sách thực tế nhập vào kệ ban đầu.</small>
                    </div>
                }
            </div>
        </div>

        <!-- Card Trạng thái & Hành động -->
        <div class="card border-0 shadow-sm" style="border-radius: var(--bk-radius);">
            <div class="card-body p-4">
                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                    <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">
                        Đang kinh doanh / Hiển thị
                    </label>
                    <small class="text-muted d-block">Bỏ chọn nếu muốn tạm thời ẩn sách khỏi Kiosk và POS.</small>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary py-2 shadow-sm">
                        <i class="fas fa-save me-1"></i> @(Model.IsEditMode ? "Lưu thay đổi" : "Tạo sách mới")
                    </button>
                    <a asp-action="Index" class="btn btn-light py-2 text-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Live preview ảnh bìa sách khi dán URL
    document.getElementById('bookImageUrlInput')?.addEventListener('input', function (e) {
        const url = e.target.value.trim();
        const img = document.getElementById('bookCoverImg');
        if (img) {
            img.src = url || 'https://placehold.co/140x190/f8f9fa/6c757d?text=No+Cover';
        }
    });
</script>

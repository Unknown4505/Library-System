@* Partial View: _Sidebar.cshtml *@
@{
    var currentPath = Context.Request.Path.Value ?? "";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="sidebar d-flex flex-column" id="sidebar">
    <!-- Brand -->
    <a href="/" class="brand text-white text-decoration-none">
        <i class="fas fa-book-reader me-2 fs-4"></i>
        <span>BookKiosk</span>
    </a>

    <!-- Menu Items -->
    <div class="sidebar-nav py-2 flex-grow-1 overflow-auto">
        @if (isAdmin)
        {
            <!-- SECTION: TỔNG QUAN -->
            <div class="sidebar-heading">Tổng quan</div>
            <a href="/" class="nav-link @((currentPath == "/" || currentPath == "/Home" || currentPath == "/Home/Index") ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="/Home/StaffWorkspace" class="nav-link @(currentPath.StartsWith("/Home/StaffWorkspace") ? "active" : "")">
                <i class="fas fa-briefcase"></i>
                <span>Trang làm việc</span>
            </a>

            <!-- SECTION: QUẢN LÝ CATALOG -->
            <div class="sidebar-heading mt-2">Sách & Danh mục</div>
            <a href="/Books" class="nav-link @(currentPath.StartsWith("/Books") ? "active" : "")">
                <i class="fas fa-book"></i>
                <span>Quản lý Sách</span>
            </a>
            <a href="/Categories" class="nav-link @(currentPath.StartsWith("/Categories") ? "active" : "")">
                <i class="fas fa-th-list"></i>
                <span>Thể loại</span>
            </a>
            <a href="/Areas" class="nav-link @(currentPath.StartsWith("/Areas") ? "active" : "")">
                <i class="fas fa-map-marked-alt"></i>
                <span>Khu vực & Kệ sách</span>
            </a>

            <!-- SECTION: KHO HÀNG -->
            <div class="sidebar-heading mt-2">Kho hàng</div>
            <a href="/Inventory" class="nav-link @(currentPath.StartsWith("/Inventory") ? "active" : "")">
                <i class="fas fa-warehouse"></i>
                <span>Nhập kho & Tồn</span>
            </a>
            <a href="/Suppliers" class="nav-link @(currentPath.StartsWith("/Suppliers") ? "active" : "")">
                <i class="fas fa-truck"></i>
                <span>Nhà cung cấp</span>
            </a>

            <!-- SECTION: BÁN HÀNG & KHÁCH HÀNG -->
            <div class="sidebar-heading mt-2">Bán hàng</div>
            <a href="/Pos" class="nav-link @(currentPath.StartsWith("/Pos") ? "active" : "")">
                <i class="fas fa-cash-register"></i>
                <span>Bán tại quầy (POS)</span>
            </a>
            <a href="/Orders" class="nav-link @(currentPath.StartsWith("/Orders") ? "active" : "")">
                <i class="fas fa-file-invoice-dollar"></i>
                <span>Hóa đơn</span>
            </a>
            <a href="/Promotions" class="nav-link @(currentPath.StartsWith("/Promotions") ? "active" : "")">
                <i class="fas fa-tags"></i>
                <span>Khuyến mãi</span>
            </a>
            <a href="/Members" class="nav-link @(currentPath.StartsWith("/Members") ? "active" : "")">
                <i class="fas fa-id-card"></i>
                <span>Thẻ thành viên</span>
            </a>

            <!-- SECTION: HỆ THỐNG -->
            <div class="sidebar-heading mt-2">Hệ thống</div>
            <a href="/Kiosks" class="nav-link @(currentPath.StartsWith("/Kiosks") ? "active" : "")">
                <i class="fas fa-desktop"></i>
                <span>Giám sát Kiosk</span>
            </a>
            <a href="/Reports" class="nav-link @(currentPath.StartsWith("/Reports") ? "active" : "")">
                <i class="fas fa-chart-line"></i>
                <span>Báo cáo doanh thu</span>
            </a>
            <a href="/Users" class="nav-link @(currentPath.StartsWith("/Users") ? "active" : "")">
                <i class="fas fa-users-cog"></i>
                <span>Tài khoản người dùng</span>
            </a>
        }
        else
        {
            <!-- SECTION CHO ROLE STAFF -->
            <div class="sidebar-heading">Bàn làm việc</div>
            <a href="/Home/StaffWorkspace" class="nav-link @(currentPath.StartsWith("/Home/StaffWorkspace") ? "active" : "")">
                <i class="fas fa-briefcase"></i>
                <span>Trang làm việc</span>
            </a>
            <a href="/Pos" class="nav-link @(currentPath.StartsWith("/Pos") || currentPath == "/" ? "active" : "")">
                <i class="fas fa-cash-register"></i>
                <span>Bán tại quầy (POS)</span>
            </a>
            <a href="/Books" class="nav-link @(currentPath.StartsWith("/Books") ? "active" : "")">
                <i class="fas fa-book"></i>
                <span>Tra cứu Sách</span>
            </a>
            <a href="/Inventory" class="nav-link @(currentPath.StartsWith("/Inventory") ? "active" : "")">
                <i class="fas fa-dolly"></i>
                <span>Nhập kho</span>
            </a>
            <a href="/Orders" class="nav-link @(currentPath.StartsWith("/Orders") ? "active" : "")">
                <i class="fas fa-receipt"></i>
                <span>Tra cứu Hóa đơn</span>
            </a>
            <a href="/Promotions" class="nav-link @(currentPath.StartsWith("/Promotions") ? "active" : "")">
                <i class="fas fa-tags"></i>
                <span>Chương trình khuyến mãi</span>
            </a>
            <a href="/Members" class="nav-link @(currentPath.StartsWith("/Members") ? "active" : "")">
                <i class="fas fa-id-card"></i>
                <span>Khách hàng thành viên</span>
            </a>
        }
    </div>

    <!-- Sidebar Footer -->
    <div class="p-3 border-top border-white border-opacity-10 text-center small text-white-50">
        <i class="fas fa-shield-alt me-1 text-warning"></i>
        <span>Vai trò: <strong class="text-white">@(isAdmin ? "Quản trị viên" : "Nhân viên")</strong></span>
    </div>
</div>

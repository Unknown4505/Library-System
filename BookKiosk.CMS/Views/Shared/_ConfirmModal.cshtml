@* Partial View: _ConfirmModal.cshtml *@
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: var(--bk-radius);">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="confirmModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i> Xác nhận thao tác
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p id="confirmModalMessage" class="fs-6 text-secondary mb-0">Bạn có chắc chắn muốn thực hiện hành động này?</p>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Hủy bỏ
                </button>
                <form id="confirmModalForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="confirmModalSubmitBtn" class="btn btn-danger px-3">
                        <i class="fas fa-check me-1"></i> Đồng ý
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function showConfirmModal(actionUrl, message, confirmButtonText = 'Đồng ý', confirmButtonClass = 'btn-danger') {
        const modalForm = document.getElementById('confirmModalForm');
        const modalMsg = document.getElementById('confirmModalMessage');
        const submitBtn = document.getElementById('confirmModalSubmitBtn');

        if (modalForm) modalForm.action = actionUrl;
        if (modalMsg) modalMsg.innerText = message;
        if (submitBtn) {
            submitBtn.className = 'btn px-3 ' + confirmButtonClass;
            submitBtn.innerHTML = '<i class="fas fa-check me-1"></i> ' + confirmButtonText;
        }

        const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
        modal.show();
    }
</script>

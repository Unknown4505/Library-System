@* Partial View: _LoadingSpinner.cshtml *@
<div id="globalLoadingSpinner" class="d-none position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center" style="background-color: rgba(255, 255, 255, 0.7); z-index: 9999;">
    <div class="text-center p-4 rounded bg-white shadow-sm border">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Đang xử lý...</span>
        </div>
        <div class="mt-3 fw-bold text-primary fs-6" id="globalLoadingText">Đang tải dữ liệu...</div>
    </div>
</div>

<script>
    function showLoading(text = 'Đang tải dữ liệu...') {
        const spinner = document.getElementById('globalLoadingSpinner');
        const spinnerText = document.getElementById('globalLoadingText');
        if (spinnerText) spinnerText.innerText = text;
        if (spinner) {
            spinner.classList.remove('d-none');
            spinner.classList.add('d-flex');
        }
    }

    function hideLoading() {
        const spinner = document.getElementById('globalLoadingSpinner');
        if (spinner) {
            spinner.classList.remove('d-flex');
            spinner.classList.add('d-none');
        }
    }
</script>

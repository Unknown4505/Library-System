<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookKiosk Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <!-- Design System Tokens & Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex">
    <!-- Sidebar Phân quyền theo Role -->
    <partial name="_Sidebar" />

    <!-- Main Content Wrapper -->
    <div class="content-wrapper flex-grow-1 min-vh-100 d-flex flex-column">
        <!-- Topbar Header -->
        <partial name="_Header" />

        <!-- Page Content -->
        <main class="container-fluid px-4 flex-grow-1">
            <!-- Global Flash Alerts -->
            <partial name="_Alert" />

            <!-- Body View -->
            @RenderBody()
        </main>

        <!-- Sticky Footer -->
        <footer class="sticky-footer bg-white mt-auto py-3 border-top">
            <div class="container-fluid px-4 my-auto">
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <span>Copyright &copy; BookKiosk CMS @DateTime.Now.Year</span>
                    <span>Hệ thống Quản lý Kiosk Bán Sách v1.0</span>
                </div>
            </div>
        </footer>
    </div>

    <!-- Shared Modals & Global Components -->
    <partial name="_ConfirmModal" />
    <partial name="_LoadingSpinner" />
    <partial name="_Toast" />

    <!-- JavaScript Dependencies -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Sidebar Toggle Script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("sidebarToggle");
            const sidebar = document.getElementById("sidebar");
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle("d-none");
                });
            }
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Global Notification Bell Updater (Chỉ đếm Cần hỗ trợ trong Tuần 6) -->
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                function refreshNeedsSupportBadge() {
                    const badge = document.getElementById("notificationBadge");
                    if (!badge) return;
                    fetch("/Orders/GetNeedsSupportCount", { headers: { "Accept": "application/json" } })
                        .then(r => r.json())
                        .then(d => {
                            if (d && d.count > 0) {
                                badge.textContent = d.count > 99 ? "99+" : d.count;
                                badge.classList.remove("d-none");
                            } else {
                                badge.classList.add("d-none");
                            }
                        })
                        .catch(() => {});
                }
                refreshNeedsSupportBadge();
                setInterval(refreshNeedsSupportBadge, 30000);
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

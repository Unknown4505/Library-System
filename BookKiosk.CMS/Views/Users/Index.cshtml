@model BookKiosk.CMS.ViewModels.Users.UserManagementViewModel
@{
    ViewData["Title"] = "Tài khoản người dùng - BookKiosk CMS";
}

<partial name="_Alert" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1 fw-bold"><i class="fas fa-users-cog me-2 text-primary"></i>Tài khoản người dùng</h1>
        <div class="text-muted small">Dữ liệu trực tiếp từ Backend <code>/api/users</code></div>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal" @(Model.IsBackendAvailable ? null : "disabled")>
        <i class="fas fa-user-plus me-1"></i>Thêm tài khoản
    </button>
</div>

@if (!Model.IsBackendAvailable)
{
    <div class="alert alert-danger">
        <strong>Không tải được dữ liệu tài khoản.</strong> @Model.StatusMessage
    </div>
}

<div class="row g-3 mb-4">
    @foreach (var card in new[]
    {
        ("Tổng tài khoản", Model.TotalUsers, "primary", "fa-users"),
        ("Admin", Model.AdminCount, "danger", "fa-user-shield"),
        ("Manager", Model.ManagerCount, "warning", "fa-user-tie"),
        ("Staff", Model.StaffCount, "info", "fa-user-tag")
    })
    {
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-start border-@card.Item3 border-4 h-100">
                <div class="card-body d-flex justify-content-between">
                    <div><div class="small text-uppercase fw-bold text-@card.Item3">@card.Item1</div><div class="h4 mb-0">@(Model.IsBackendAvailable ? card.Item2.ToString() : "--")</div></div>
                    <i class="fas @card.Item4 fa-2x text-@card.Item3 opacity-50"></i>
                </div>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-5"><input name="search" value="@Model.SearchKeyword" class="form-control" placeholder="Tên đăng nhập hoặc họ tên" /></div>
            <div class="col-md-2">
                <select name="role" class="form-select">
                    <option value="">Tất cả vai trò</option>
                    <!option value="Admin" @(Model.SelectedRole == "Admin" ? "selected" : "")>Admin</!option>
                    <!option value="Manager" @(Model.SelectedRole == "Manager" ? "selected" : "")>Manager</!option>
                    <!option value="Staff" @(Model.SelectedRole == "Staff" ? "selected" : "")>Staff</!option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <!option value="true" @(Model.SelectedStatus == true ? "selected" : "")>Hoạt động</!option>
                    <!option value="false" @(Model.SelectedStatus == false ? "selected" : "")>Đã khóa</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Lọc</button><a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Tên đăng nhập</th><th>Họ tên</th><th>Vai trò</th><th>Trạng thái</th><th class="text-end">Hành động</th></tr></thead>
            <tbody>
            @if (!Model.Users.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-5">
                    @(Model.IsBackendAvailable ? "Không có tài khoản phù hợp." : "Dịch vụ tài khoản hiện không khả dụng. Vui lòng kiểm tra kết nối máy chủ.")
                </td></tr>
            }
            else
            {
                @foreach (var user in Model.Users.Items)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td><code class="fw-bold">@user.Username</code></td>
                        <td>@user.FullName</td>
                        <td>
                            @switch (user.Role)
                            {
                                case BookKiosk.Domain.Enums.UserRole.Admin:
                                    <span class="badge bg-danger">Admin</span>
                                    break;
                                case BookKiosk.Domain.Enums.UserRole.Manager:
                                    <span class="badge bg-warning text-dark">Manager</span>
                                    break;
                                default:
                                    <span class="badge bg-info text-dark">Staff</span>
                                    break;
                            }
                        </td>
                        <td><span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Hoạt động" : "Đã khóa")</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editUser-@user.UserId" title="Sửa"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#passwordUser-@user.UserId" title="Đặt lại mật khẩu"><i class="fas fa-key"></i></button>
                            <form asp-action="Status" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.UserId" /><input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                <button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Vô hiệu hóa" : "Kích hoạt")"><i class="fas @(user.IsActive ? "fa-lock" : "fa-unlock")"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Users.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination justify-content-center">
    @for (var p = 1; p <= Model.Users.TotalPages; p++)
    {
        <li class="page-item @(p == Model.Users.PageIndex ? "active" : null)"><a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.SearchKeyword" asp-route-role="@Model.SelectedRole" asp-route-isActive="@Model.SelectedStatus">@p</a></li>
    }
    </ul></nav>
}

<div class="modal fade" id="createUserModal" tabindex="-1"><div class="modal-dialog"><form asp-action="Create" method="post" class="modal-content">
    @Html.AntiForgeryToken()
    <div class="modal-header"><h5 class="modal-title">Thêm tài khoản</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <label class="form-label">Tên đăng nhập</label><input name="Username" class="form-control mb-3" required minlength="3" maxlength="50" pattern="[a-zA-Z0-9_]+" />
        <label class="form-label">Họ tên</label><input name="FullName" class="form-control mb-3" required minlength="2" maxlength="100" />
        <label class="form-label">Vai trò</label><select name="Role" class="form-select mb-3"><option>Staff</option><option>Manager</option><option>Admin</option></select>
        <label class="form-label">Mật khẩu</label><input name="Password" type="password" class="form-control" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" autocomplete="new-password" />
        <small class="text-muted d-block mt-1">Tối thiểu 8 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường và 1 chữ số.</small>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Tạo tài khoản</button></div>
</form></div></div>

@foreach (var user in Model.Users.Items)
{
    <div class="modal fade" id="editUser-@user.UserId" tabindex="-1"><div class="modal-dialog"><form asp-action="Edit" method="post" class="modal-content">
        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.UserId" />
        <div class="modal-header"><h5 class="modal-title">Sửa @user.Username</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><label class="form-label">Họ tên</label><input name="fullName" value="@user.FullName" class="form-control mb-3" required minlength="2" maxlength="100" /><label class="form-label">Vai trò</label><select name="role" class="form-select"><!option value="Staff" @(user.Role.ToString() == "Staff" ? "selected" : "")>Staff</!option><!option value="Manager" @(user.Role.ToString() == "Manager" ? "selected" : "")>Manager</!option><!option value="Admin" @(user.Role.ToString() == "Admin" ? "selected" : "")>Admin</!option></select></div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Lưu</button></div>
    </form></div></div>
    <div class="modal fade" id="passwordUser-@user.UserId" tabindex="-1"><div class="modal-dialog"><form asp-action="ResetPassword" method="post" class="modal-content">
        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.UserId" />
        <div class="modal-header"><h5 class="modal-title">Đặt lại mật khẩu @user.Username</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <label class="form-label">Mật khẩu mới</label><input name="newPassword" type="password" class="form-control" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" autocomplete="new-password" />
            <small class="text-muted d-block mb-3 mt-1">Tối thiểu 8 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường và 1 chữ số.</small>
            <label class="form-label">Xác nhận mật khẩu</label><input name="confirmPassword" type="password" class="form-control" required minlength="8" autocomplete="new-password" />
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-warning">Đặt lại</button></div>
    </form></div></div>
}

@model BookKiosk.CMS.ViewModels.Inventory.SupplierListViewModel
@{
    ViewData["Title"] = "Quản lý Nhà cung cấp";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1 fw-bold text-dark">
            <i class="fas fa-truck text-primary me-2"></i>Quản lý Nhà cung cấp
        </h1>
        <p class="text-muted small mb-0">Danh sách các đối tác xuất bản và nhà phân phối cung ứng sách cho Kiosk.</p>
    </div>
    @if (canManage)
    {
    <div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
            <i class="fas fa-plus-circle me-1"></i> Thêm nhà cung cấp
        </button>
    </div>
    }
</div>

<!-- Alert Thông báo -->

@if (Model.LoadError != null)
{
    <div class="alert alert-danger" role="alert">@Model.LoadError</div>
}

<!-- Main Content Card -->
<div class="card border-0 shadow-sm" style="border-radius: var(--bk-radius);">
    <!-- Card Header / Toolbar -->
    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0 fw-bold text-dark">Danh sách đối tác</h6>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-2" id="supplierCountBadge">
                @Model.Suppliers.Count() đối tác
            </span>
        </div>
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-light border-end-0 text-muted">
                <i class="fas fa-search"></i>
            </span>
            <input type="text" id="supplierSearchInput" class="form-control bg-light border-start-0" 
                   placeholder="Tìm kiếm đối tác, SĐT, người liên hệ..." />
        </div>
    </div>

    <!-- Table Body -->
    <div class="card-body p-0">
        @if (!Model.Suppliers.Any())
        {
            <partial name="_EmptyState" model='"Hiện chưa có nhà cung cấp nào trong hệ thống."' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="supplierTable">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4" style="width: 70px;">Mã</th>
                            <th style="min-width: 220px;">Nhà cung cấp</th>
                            <th>Người đại diện</th>
                            <th>Liên hệ</th>
                            <th>Địa chỉ</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4" style="width: 130px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Suppliers)
                        {
                            <tr class="supplier-row" 
                                data-name="@s.Name.ToLower()" 
                                data-contact="@(s.ContactName?.ToLower() ?? "")" 
                                data-phone="@(s.PhoneNumber ?? "")"
                                data-email="@(s.Email?.ToLower() ?? "")">
                                <td class="ps-4 fw-semibold text-muted">#@s.SupplierId</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@s.Name</div>
                                            <small class="text-muted">ID: NCC-@s.SupplierId.ToString("D3")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.ContactName))
                                    {
                                        <div class="text-dark fw-medium small">
                                            <i class="fas fa-user-tie text-secondary me-1"></i>@s.ContactName
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(s.PhoneNumber))
                                    {
                                        <div class="small text-dark font-monospace">
                                            <i class="fas fa-phone-alt text-success me-1"></i>@s.PhoneNumber
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(s.Email))
                                    {
                                        <div class="small text-muted">
                                            <i class="fas fa-envelope text-primary me-1"></i>@s.Email
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small" title="@s.Address">
                                        @(string.IsNullOrWhiteSpace(s.Address) ? "—" : (s.Address.Length > 35 ? s.Address.Substring(0, 32) + "..." : s.Address))
                                    </span>
                                </td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="fas fa-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="fas fa-ban me-1"></i>Vô hiệu
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (canManage)
                                    {
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-primary" title="Sửa thông tin"
                                                data-supplier-edit data-url="@Url.Action("Edit", "Suppliers", new { id = s.SupplierId })"
                                                data-name="@s.Name" data-contact="@s.ContactName" data-phone="@s.PhoneNumber"
                                                data-email="@s.Email" data-address="@s.Address" data-active="@s.IsActive.ToString().ToLowerInvariant()">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (s.IsActive)
                                        {
                                            <button type="button" class="btn btn-outline-warning" title="Vô hiệu hóa nhà cung cấp"
                                                    data-supplier-delete data-url="@Url.Action("Delete", "Suppliers", new { id = s.SupplierId })" data-name="@s.Name">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        }
                                    </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (canManage)
{
    @foreach (var mode in new[] { "create", "edit" })
    {
        var editing = mode == "edit";
        var active = Model.ActiveForm == mode;
        var modalId = mode + "SupplierModal";
        var values = editing
            ? new Dictionary<string, string?> { ["Name"] = Model.EditForm.Name, ["PhoneNumber"] = Model.EditForm.PhoneNumber, ["ContactName"] = Model.EditForm.ContactName, ["Email"] = Model.EditForm.Email, ["Address"] = Model.EditForm.Address }
            : new Dictionary<string, string?> { ["Name"] = Model.CreateForm.Name, ["PhoneNumber"] = Model.CreateForm.PhoneNumber, ["ContactName"] = Model.CreateForm.ContactName, ["Email"] = Model.CreateForm.Email, ["Address"] = Model.CreateForm.Address };
        var fields = new[] { ("Name", "Tên nhà cung cấp", 255, "text", true), ("PhoneNumber", "Số điện thoại", 20, "tel", true), ("ContactName", "Người đại diện", 100, "text", false), ("Email", "Email", 100, "email", false), ("Address", "Địa chỉ kho / trụ sở", 500, "text", false) };
        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@(modalId + "Label")" aria-hidden="true" data-reopen="@(active ? "true" : "false")">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <form id="@(mode + "SupplierForm")" method="post" action="@(editing ? Url.Action("Edit", "Suppliers", new { id = Model.EditId ?? 0 }) : Url.Action("Create", "Suppliers"))" data-supplier-form>
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(modalId + "Label")">@(editing ? "Cập nhật nhà cung cấp" : "Thêm nhà cung cấp")</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div data-form-error class="alert alert-danger @(active && ViewData.ModelState[string.Empty]?.Errors.Count > 0 ? "" : "d-none")" role="alert" tabindex="-1">
                            @if (active && ViewData.ModelState[string.Empty] is { } general)
                            {
                                foreach (var error in general.Errors) { <div>@error.ErrorMessage</div> }
                            }
                        </div>
                        @foreach (var (name, label, limit, type, required) in fields)
                        {
                            var id = mode + "Supplier" + name;
                            var error = active ? ViewData.ModelState[name]?.Errors.FirstOrDefault()?.ErrorMessage : null;
                            var value = active ? ViewData.ModelState[name]?.AttemptedValue ?? values[name] : values[name];
                            <div class="mb-3">
                                <label class="form-label" for="@id">@label @if (required) { <span class="text-danger">*</span> }</label>
                                @if (name == "Address")
                                {
                                    <textarea id="@id" name="@name" class="form-control @(error != null ? "is-invalid" : "")" maxlength="@limit" rows="2" aria-describedby="@(id + "Error")" aria-invalid="@(error != null ? "true" : "false")">@value</textarea>
                                }
                                else
                                {
                                    <input id="@id" name="@name" type="@type" value="@value" class="form-control @(error != null ? "is-invalid" : "")" required="@required" maxlength="@limit" aria-describedby="@(id + "Error")" aria-invalid="@(error != null ? "true" : "false")" />
                                }
                                <span id="@(id + "Error")" class="invalid-feedback" data-field-error="@name">@error</span>
                            </div>
                        }
                        @if (editing)
                        {
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" id="editSupplierIsActive" name="IsActive" value="true" checked="@Model.EditForm.IsActive" />
                                <input type="hidden" name="IsActive" value="false" />
                                <label class="form-check-label" for="editSupplierIsActive">Đang hợp tác / Hoạt động</label>
                            </div>
                        }
                        else { <input type="hidden" name="IsActive" value="@Model.CreateForm.IsActive.ToString().ToLowerInvariant()" /> }
                        <span data-submit-status class="small text-muted" role="status" aria-live="polite"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">@(editing ? "Cập nhật" : "Lưu nhà cung cấp")</button>
                    </div>
                </form>
            </div></div>
        </div>
    }
}
@section Scripts {
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}

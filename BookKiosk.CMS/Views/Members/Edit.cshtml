@model BookKiosk.CMS.ViewModels.Members.MemberFormViewModel
@{
    ViewData["Title"] = $"Cập nhật Thành viên - {Model.PhoneNumber}";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">Thẻ thành viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Cập nhật #@Model.PhoneNumber</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center justify-content-between">
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fas fa-user-edit text-primary me-2"></i>Cập nhật Thông tin Thành viên
            </h4>
            <a asp-action="Index" asp-route-phone="@Model.PhoneNumber" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Alert / Toast -->
    <partial name="_Alert" />
    <partial name="_Toast" />

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0 text-primary">
                        <i class="fas fa-id-card me-2"></i>Chỉnh sửa hồ sơ hội viên
                    </h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.MemberId" method="post" id="memberEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MemberId" />
                        <input type="hidden" asp-for="PhoneNumber" />

                        <!-- Số điện thoại (Chỉ đọc) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">Số điện thoại thành viên (Mã định danh)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fas fa-lock"></i>
                                </span>
                                <input type="text" value="@Model.PhoneNumber" class="form-control border-start-0 bg-light text-dark fw-bold fs-5" disabled />
                            </div>
                            <div class="form-text small text-muted">Số điện thoại là duy nhất và không được phép chỉnh sửa trực tiếp.</div>
                        </div>

                        <!-- Điểm tích lũy hiện tại (Chỉ đọc) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">Điểm tích lũy hiện có</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-warning border-end-0">
                                    <i class="fas fa-coins"></i>
                                </span>
                                <input type="text" value="@Model.Points.ToString("N0") điểm (@((Model.Points * 1000).ToString("N0")) ₫)" 
                                       class="form-control border-start-0 bg-light text-dark fw-bold fs-5" disabled />
                            </div>
                            <div class="form-text small text-muted">Điểm số do hệ thống Backend tự động ghi nhận theo các đơn hàng mua sách.</div>
                        </div>

                        <!-- Họ và tên (Cho phép sửa) -->
                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label fw-semibold">
                                Họ và tên thành viên <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-user text-primary"></i>
                                </span>
                                <input asp-for="FullName" class="form-control border-start-0 fs-5" autofocus />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Nút thao tác -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <a asp-action="Index" asp-route-phone="@Model.PhoneNumber" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold">
                                <i class="fas fa-save me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

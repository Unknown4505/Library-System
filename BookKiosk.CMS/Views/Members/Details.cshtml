@model BookKiosk.CMS.ViewModels.Members.MemberDetailsViewModel
@{
    ViewData["Title"] = $"Hồ sơ Thành viên - {Model.Member.FullName}";
}

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">Thẻ thành viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ sơ hội viên</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark">
                    <i class="fas fa-id-card text-primary me-2"></i>Chi tiết Hồ sơ Thành viên
                </h4>
                <p class="text-muted small mb-0">Hội viên: <strong class="text-dark">@Model.Member.FullName</strong> (@Model.Member.PhoneNumber)</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-phone="@Model.Member.PhoneNumber" class="btn btn-outline-primary">
                    <i class="fas fa-user-edit me-1"></i> Chỉnh sửa họ tên
                </a>
                <a asp-action="Index" asp-route-phone="@Model.Member.PhoneNumber" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Alert / Toast -->
    <partial name="_Alert" />
    <partial name="_Toast" />

    <!-- Hàng Widget Thống kê Điểm thưởng -->
    <div class="row g-4 mb-4">
        <!-- Thẻ Thành viên đồ họa -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 text-white p-4 h-100 position-relative overflow-hidden" 
                 style="background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%); min-height: 220px;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="badge @Model.Member.RankBadgeClass fw-bold px-2 py-1">
                        <i class="fas fa-crown me-1"></i>@Model.Member.RankName
                    </span>
                    <i class="fas fa-sim-card fa-2x text-warning opacity-75"></i>
                </div>
                <h4 class="fw-bold text-white mb-1">@Model.Member.FullName</h4>
                <div class="fs-6 font-monospace opacity-75 mb-3">
                    <i class="fas fa-phone-alt me-1"></i>@Model.Member.PhoneNumber
                </div>
                <div class="mt-auto pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-end">
                    <div>
                        <small class="text-uppercase opacity-75 d-block">Điểm tích lũy</small>
                        <span class="fs-4 fw-bold text-warning">@Model.Member.Points.ToString("N0")</span>
                    </div>
                    <div class="text-end">
                        <small class="text-uppercase opacity-75 d-block">Quy đổi</small>
                        <span class="fs-5 fw-bold text-success-light">@Model.Member.PointMoneyValue.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3 Thống kê chi tiết biến động điểm -->
        <div class="col-lg-8">
            <div class="row g-3 h-100">
                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Điểm khả dụng</span>
                            <h3 class="fw-bold mb-0 text-dark mt-2">@Model.Member.Points.ToString("N0")</h3>
                        </div>
                        <div class="small text-success fw-semibold mt-2">
                            <i class="fas fa-coins me-1"></i> ~@Model.Member.PointMoneyValue.ToString("N0") ₫
                        </div>
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng điểm đã tích (+)</span>
                            <h3 class="fw-bold mb-0 text-success mt-2">+@Model.TotalEarnedPoints.ToString("N0")</h3>
                        </div>
                        <div class="small text-muted mt-2">
                            <i class="fas fa-plus-circle text-success me-1"></i> Tích từ đơn hàng
                        </div>
                    </div>
                </div>

                <div class="col-sm-4">
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger h-100 d-flex flex-column justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng điểm đã tiêu (-)</span>
                            <h3 class="fw-bold mb-0 text-danger mt-2">-@Model.TotalRedeemedPoints.ToString("N0")</h3>
                        </div>
                        <div class="small text-muted mt-2">
                            <i class="fas fa-minus-circle text-danger me-1"></i> Đã trừ thanh toán
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng toàn bộ lịch sử biến động điểm -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fas fa-history me-2 text-primary"></i>Toàn bộ Lịch sử Biến động Điểm
            </h6>

            <!-- Nav Tabs lọc loại giao dịch -->
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link px-3 py-1 @(Model.FilterType == "all" ? "active" : "")" 
                       asp-action="Details" asp-route-phone="@Model.Member.PhoneNumber" asp-route-filter="all">
                        Tất cả
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-1 @(Model.FilterType == "earned" ? "active" : "")" 
                       asp-action="Details" asp-route-phone="@Model.Member.PhoneNumber" asp-route-filter="earned">
                        Tích điểm (+)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-1 @(Model.FilterType == "redeemed" ? "active" : "")" 
                       asp-action="Details" asp-route-phone="@Model.Member.PhoneNumber" asp-route-filter="redeemed">
                        Tiêu điểm (-)
                    </a>
                </li>
            </ul>
        </div>

        <div class="card-body p-0">
            @if (Model.PointHistory == null || !Model.PointHistory.Any())
            {
                <div class="p-4 text-center">
                    <partial name="_EmptyState" model="@("Không có giao dịch tích hoặc tiêu điểm nào theo bộ lọc này.")" />
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary text-uppercase small">
                            <tr>
                                <th class="ps-4">Mã GD</th>
                                <th>Thời gian giao dịch</th>
                                <th>Loại nghiệp vụ</th>
                                <th>Số điểm</th>
                                <th>Giá trị quy đổi</th>
                                <th>Đơn hàng liên kết</th>
                                <th class="pe-4">Diễn giải chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.PointHistory)
                            {
                                <tr>
                                    <td class="ps-4 font-monospace small text-muted">
                                        #@tx.PointTransactionId
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@tx.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">@tx.CreatedAt.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <span class="badge @tx.BadgeClass">
                                            @tx.TypeText
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@(tx.Type == 1 ? "text-success" : "text-danger") fw-bold fs-6">
                                            @tx.PointsDisplay
                                        </span>
                                    </td>
                                    <td class="small text-muted fw-semibold">
                                        @tx.MoneyEquivalent
                                    </td>
                                    <td>
                                        @if (tx.OrderId.HasValue && tx.OrderId.Value > 0)
                                        {
                                            <span class="badge bg-light text-primary border">
                                                <i class="fas fa-receipt me-1"></i> Đơn #@tx.OrderId.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Hệ thống</span>
                                        }
                                    </td>
                                    <td class="pe-4 small text-secondary">
                                        @(string.IsNullOrWhiteSpace(tx.Description) ? "Biến động điểm tiêu chuẩn" : tx.Description)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

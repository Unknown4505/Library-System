<mxfile host="app.diagrams.net">
  <diagram name="dfd ( level 1 )" id="qhH52OYbz6A3iVz4sMp1">
    <mxGraphModel dx="13949" dy="5878" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% DFD Level 1 - giu nguyen 7 xu ly nghiep vu tu BFD\n    %% Bo sung 8.0/ D8.Users cho xac thuc CMS (PLANNED).\n    %% DFD mo ta THIET KE MUC TIEU, khong phai tat ca da IMPLEMENTED.\n    %% Kho du lieu D1-D7 la NHOM LOGIC gom cac bang, khong phai bang moi.\n\n    KH[\&quot;E1. Khách hàng\&quot;]\n    NV[\&quot;E2. Nhân viên / Admin\&quot;]\n    NCC[\&quot;E3. Nhà cung cấp\&quot;]\n    SEP[\&quot;E4. SePay\&quot;]\n    SCAN[\&quot;E5. Máy quét mã vạch\&quot;]\n    PRN[\&quot;E6. Máy in hóa đơn (Mock / tùy chọn)\&quot;]\n    DEV[\&quot;E7. Thiết bị Kiosk\&quot;]\n\n    P1((\&quot;1.0 Quản lý sản phẩm\&quot;))\n    P2((\&quot;2.0 Bán hàng tại Kiosk\&quot;))\n    P3((\&quot;3.0 Quản lý kho nhập\&quot;))\n    P4((\&quot;4.0 Thành viên và điểm\&quot;))\n    P5((\&quot;5.0 Quản lý khuyến mãi\&quot;))\n    P6((\&quot;6.0 Kiosk và thiết bị\&quot;))\n    P7((\&quot;7.0 Thống kê và báo cáo\&quot;))\n    P8((\&quot;8.0 Đăng nhập CMS và phân quyền (PLANNED)\&quot;))\n\n    D1[(\&quot;D1. Books / Categories / Areas\&quot;)]\n    D2[(\&quot;D2. Suppliers / ImportReceipts / ImportReceiptDetails\&quot;)]\n    D3[(\&quot;D3. Members / PointTransactions\&quot;)]\n    D4[(\&quot;D4. Promotions / PromotionOrderDiscounts / PromotionProductDiscounts\&quot;)]\n    D5[(\&quot;D5. Orders / OrderDetails\&quot;)]\n    D6[(\&quot;D6. PaymentTransactions\&quot;)]\n    D7[(\&quot;D7. Kiosks / KioskIncidents\&quot;)]\n    D8[(\&quot;D8. Users\&quot;)]\n\n    %% Auth CMS: Users da co trong model; /api/auth/login con PLANNED.\n    NV --&gt;|\&quot;Username, password\&quot;| P8\n    P8 --&gt;|\&quot;Tra cứu tài khoản\&quot;| D8\n    D8 --&gt;|\&quot;Username, PasswordHash, Role, IsActive\&quot;| P8\n    P8 --&gt;|\&quot;JWT hoặc lỗi xác thực\&quot;| NV\n\n    %% 1.0 Quan ly san pham\n    NV --&gt;|\&quot;JWT + thông tin sách, danh mục, khu vực\&quot;| P1\n    P1 --&gt;|\&quot;Kết quả quản lý sản phẩm\&quot;| NV\n    D1 --&gt;|\&quot;Sách, danh mục, vị trí hiện có\&quot;| P1\n    P1 --&gt;|\&quot;Bản ghi sản phẩm cập nhật\&quot;| D1\n\n    %% 2.0 Ban hang Kiosk\n    KH --&gt;|\&quot;Tìm sách, chọn sách, SĐT, dùng điểm, hủy đơn\&quot;| P2\n    SCAN --&gt;|\&quot;Mã vạch sách\&quot;| P2\n    SEP --&gt;|\&quot;Webhook giao dịch chuyển khoản\&quot;| P2\n    P2 --&gt;|\&quot;Danh sách sách, giỏ, QR, kết quả, hóa đơn\&quot;| KH\n    P2 --&gt;|\&quot;Dữ liệu in hóa đơn sau Paid\&quot;| PRN\n    D1 --&gt;|\&quot;Giá bán, tồn khả dụng, barcode\&quot;| P2\n    P2 --&gt;|\&quot;Giữ kho, trừ kho hoặc nhả kho\&quot;| D1\n    D5 --&gt;|\&quot;Mã đơn, chi tiết, trạng thái\&quot;| P2\n    P2 --&gt;|\&quot;Đơn Pending/Paid/Cancelled và chi tiết\&quot;| D5\n    D6 --&gt;|\&quot;Giao dịch đã ghi nhận\&quot;| P2\n    P2 --&gt;|\&quot;Giao dịch thanh toán hợp lệ\&quot;| D6\n\n    %% Diem va KM la xu ly nghiep vu rieng, duoc P2 goi\n    P2 --&gt;|\&quot;Tra cứu thành viên, kiểm tra và ghi nhận điểm\&quot;| P4\n    P4 --&gt;|\&quot;Thông tin thành viên, số dư, kết quả điểm\&quot;| P2\n    P2 --&gt;|\&quot;Giỏ hàng và yêu cầu chọn ưu đãi\&quot;| P5\n    P5 --&gt;|\&quot;Khuyến mãi hợp lệ, mức giảm\&quot;| P2\n\n    %% 3.0 Kho\n    NCC --&gt;|\&quot;Thông tin nguồn hàng, chứng từ nhập\&quot;| P3\n    NV --&gt;|\&quot;JWT + phiếu nhập và số lượng nhập\&quot;| P3\n    P3 --&gt;|\&quot;Xác nhận phiếu nhập, số lượng tồn\&quot;| NV\n    D2 --&gt;|\&quot;Nhà cung cấp và phiếu nhập trước đó\&quot;| P3\n    P3 --&gt;|\&quot;Thông tin nhà cung cấp, phiếu nhập, chi tiết\&quot;| D2\n    D1 --&gt;|\&quot;Thông tin sách trước khi nhập\&quot;| P3\n    P3 --&gt;|\&quot;Số lượng tồn sau khi nhập\&quot;| D1\n\n    %% 4.0 Thanh vien, diem\n    KH --&gt;|\&quot;Số điện thoại, thông tin đăng ký\&quot;| P4\n    P4 --&gt;|\&quot;Thông tin thành viên và điểm hiện có\&quot;| KH\n    D3 --&gt;|\&quot;Số dư, hồ sơ, lịch sử điểm\&quot;| P4\n    P4 --&gt;|\&quot;Hồ sơ, số dư và giao dịch điểm\&quot;| D3\n\n    %% 5.0 Khuyen mai\n    NV --&gt;|\&quot;JWT + cấu hình chương trình khuyến mãi\&quot;| P5\n    P5 --&gt;|\&quot;Kết quả cấu hình, danh sách ưu đãi\&quot;| NV\n    D4 --&gt;|\&quot;Điều kiện và mức giảm hiện có\&quot;| P5\n    P5 --&gt;|\&quot;Cấu hình khuyến mãi được cập nhật\&quot;| D4\n\n    %% 6.0 Kiosk va thiet bi\n    DEV --&gt;|\&quot;Heartbeat, mã Kiosk, tình trạng, mã lỗi\&quot;| P6\n    NV --&gt;|\&quot;JWT + thông tin cấu hình và xử lý sự cố\&quot;| P6\n    P6 --&gt;|\&quot;Trạng thái online/offline, danh sách sự cố\&quot;| NV\n    D7 --&gt;|\&quot;Kiosk, heartbeat, sự cố hiện có\&quot;| P6\n    P6 --&gt;|\&quot;LastPingAt, Status, Incident\&quot;| D7\n\n    %% 7.0 Bao cao\n    NV --&gt;|\&quot;JWT + yêu cầu thời gian và loại báo cáo\&quot;| P7\n    P7 --&gt;|\&quot;Doanh thu, sách bán chạy, tình trạng Kiosk\&quot;| NV\n    D1 --&gt;|\&quot;Danh mục và thông tin sách\&quot;| P7\n    D5 --&gt;|\&quot;Đơn hàng, thời gian, chi tiết bán\&quot;| P7\n    D6 --&gt;|\&quot;Giao dịch thanh toán\&quot;| P7\n    D7 --&gt;|\&quot;Trạng thái Kiosk và sự cố\&quot;| P7\n\n    NOTE[\&quot;GHI CHÚ: DFD là kiến trúc mục tiêu. Đăng nhập CMS/JWT (8.0) là PLANNED; Paid/Receipt và CMS Reports chưa được nghiệm thu E2E.\&quot;]\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nZtUjWAU_GjGS5NziYlm-21">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

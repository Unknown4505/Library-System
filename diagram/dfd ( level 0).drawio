        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% DFD Level 0 (Context) - BookKiosk\n    %% Mot tien trinh duy nhat; KHONG dat kho du lieu ben trong Level 0.\n\n    KH[\&quot;E1. Khách hàng\&quot;]\n    NV[\&quot;E2. Nhân viên / Admin\&quot;]\n    NCC[\&quot;E3. Nhà cung cấp\&quot;]\n    SEP[\&quot;E4. SePay\&quot;]\n    SCAN[\&quot;E5. Máy quét mã vạch\&quot;]\n    PRN[\&quot;E6. Máy in hóa đơn (Mock / tùy chọn)\&quot;]\n    DEV[\&quot;E7. Thiết bị Kiosk\&quot;]\n\n    SYS((\&quot;0. HỆ THỐNG BOOKKIOSK\&quot;))\n\n    KH --&gt;|\&quot;Từ khóa, giỏ hàng, số điện thoại, yêu cầu dùng điểm, yêu cầu hủy\&quot;| SYS\n    SYS --&gt;|\&quot;Thông tin sách, giỏ hàng, QR, trạng thái thanh toán, hóa đơn, số dư điểm\&quot;| KH\n\n    %% Dang nhap CMS la kien truc du kien (POST /api/auth/login chua co)\n    NV --&gt;|\&quot;Username, password (đăng nhập CMS - PLANNED)\&quot;| SYS\n    SYS --&gt;|\&quot;JWT hoặc thông báo lỗi đăng nhập (PLANNED)\&quot;| NV\n    NV --&gt;|\&quot;JWT + dữ liệu sách, nhập kho, khuyến mãi, quản lý Kiosk, yêu cầu báo cáo\&quot;| SYS\n    SYS --&gt;|\&quot;Kết quả cập nhật, tồn kho, doanh thu, sách bán chạy, sự cố Kiosk\&quot;| NV\n\n    NCC --&gt;|\&quot;Thông tin nguồn hàng và chứng từ nhập\&quot;| SYS\n    SCAN --&gt;|\&quot;Mã vạch sách\&quot;| SYS\n    DEV --&gt;|\&quot;Heartbeat: KioskId, status, mã lỗi\&quot;| SYS\n    SEP --&gt;|\&quot;Webhook: mã giao dịch, nội dung chuyển khoản, số tiền\&quot;| SYS\n    SYS --&gt;|\&quot;Dữ liệu hóa đơn sau khi Paid\&quot;| PRN\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nZtUjWAU_GjGS5NziYlm-1">

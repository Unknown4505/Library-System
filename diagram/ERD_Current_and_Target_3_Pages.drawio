        <mxCell id="erd_employees" value="Employees (TARGET MODEL)&#10;────────────────────&#10;EmployeeId : int  PK&#10;EmployeeCode : varchar(50)  UNIQUE&#10;UserId : int? FK→Users FILTERED UNIQUE&#10;  [UserId] IS NOT NULL; ON DELETE NO ACTION&#10;FullName : nvarchar(255)&#10;PhoneNumber : varchar(20)?&#10;Email : varchar(255)?&#10;Position : nvarchar(100)&#10;HireDate : datetime2?&#10;CurrentBaseSalary : decimal(18,0)? CHECK ≥ 0&#10;IsActive : bit&#10;CreatedAt, UpdatedAt : datetime2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F4E9;strokeColor=#33996B;strokeWidth=2;fontColor=#163B2A;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">

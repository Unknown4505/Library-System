  <diagram name="Trang-1" id="JiEDPlIGNHCPY5TFmqHk">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% BookKiosk ERD - SQL Server / EF Core main a56a94a (2026-10-11)\n    %% Mermaid format for diagrams.net -&gt; Arrange/Insert -&gt; Advanced -&gt; Mermaid\n    %% Column types are Mermaid-friendly; SQL precision/length shown in comments.\n    %% NULL = nullable; PK = primary key; FK = foreign key; UK = unique index.\n    %% AvailableStock is calculated in C#, not a database column.\n    %% Orders.KioskId does not exist in current schema.\n\n    Users {\n        int UserId PK\n        string Username UK \&quot;varchar(100)\&quot;\n        string PasswordHash \&quot;nvarchar(max)\&quot;\n        string FullName \&quot;nvarchar(max)\&quot;\n        int Role\n        bit IsActive\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Suppliers {\n        int SupplierId PK\n        string Name \&quot;nvarchar(max)\&quot;\n        string PhoneNumber \&quot;varchar(20), NULL\&quot;\n        string Email \&quot;nvarchar(max), NULL\&quot;\n        string Address \&quot;nvarchar(max), NULL\&quot;\n        bit IsActive\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Categories {\n        int CategoryId PK\n        string Name \&quot;nvarchar(255)\&quot;\n        string Description \&quot;nvarchar(max), NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Areas {\n        int AreaId PK\n        string Name \&quot;nvarchar(255)\&quot;\n        string MapCoordinates \&quot;varchar(500), NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Books {\n        int BookId PK\n        string Barcode UK \&quot;varchar(50)\&quot;\n        string Title \&quot;nvarchar(255)\&quot;\n        string Author \&quot;nvarchar(255)\&quot;\n        string Publisher \&quot;nvarchar(255), NULL\&quot;\n        string ImageUrl \&quot;nvarchar(500), NULL\&quot;\n        decimal CostPrice \&quot;decimal(18,0)\&quot;\n        decimal SellingPrice \&quot;decimal(18,0)\&quot;\n        int StockQuantity\n        int ReservedQuantity\n        bit IsActive\n        int CategoryId FK\n        int AreaId FK \&quot;int, NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    ImportReceipts {\n        int ImportReceiptId PK\n        int SupplierId FK\n        int UserId FK\n        decimal TotalAmount \&quot;decimal(18,2)\&quot;\n        string Note \&quot;nvarchar(max), NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    ImportReceiptDetails {\n        int ImportReceiptId PK,FK\n        int BookId PK,FK\n        int Quantity\n        decimal CostPrice \&quot;decimal(18,2)\&quot;\n    }\n\n    Members {\n        int MemberId PK\n        string PhoneNumber UK \&quot;varchar(20)\&quot;\n        string FullName \&quot;nvarchar(max)\&quot;\n        int Points\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Promotions {\n        int PromotionId PK\n        string Name \&quot;nvarchar(max)\&quot;\n        string Description \&quot;nvarchar(max), NULL\&quot;\n        int PromotionType\n        datetime StartDate\n        datetime EndDate\n        bit IsActive\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    PromotionOrderDiscounts {\n        int PromotionId PK,FK\n        decimal MinOrderValue \&quot;decimal(18,2)\&quot;\n        decimal DiscountAmount \&quot;decimal(18,2)\&quot;\n    }\n\n    PromotionProductDiscounts {\n        int PromotionId PK,FK\n        int BookId PK,FK\n        decimal DiscountAmount \&quot;decimal(18,2)\&quot;\n    }\n\n    Orders {\n        int OrderId PK\n        string OrderCode UK \&quot;varchar(50)\&quot;\n        int SaleChannel\n        int OrderStatus\n        int PaymentMethod\n        int UserId FK \&quot;int, NULL\&quot;\n        int MemberId FK \&quot;int, NULL\&quot;\n        int PromotionId FK \&quot;int, NULL\&quot;\n        decimal SubTotal \&quot;decimal(18,2)\&quot;\n        decimal DiscountAmount \&quot;decimal(18,2)\&quot;\n        int PointsUsed\n        decimal TotalAmount \&quot;decimal(18,2)\&quot;\n        datetime CompletedAt \&quot;datetime2, NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    OrderDetails {\n        int OrderId PK,FK\n        int BookId PK,FK\n        decimal UnitPriceAtTime \&quot;decimal(18,2)\&quot;\n        int Quantity\n        decimal LineTotal \&quot;decimal(18,2)\&quot;\n    }\n\n    PaymentTransactions {\n        int TransactionId PK\n        int OrderId FK\n        string ReferenceCode UK \&quot;varchar(50)\&quot;\n        decimal Amount \&quot;decimal(18,2)\&quot;\n        string Gateway \&quot;nvarchar(max)\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    PointTransactions {\n        int PointTransactionId PK\n        int MemberId FK\n        int OrderId FK \&quot;int, NULL\&quot;\n        int Type\n        int Points\n        string Description \&quot;nvarchar(max), NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    Kiosks {\n        int KioskId PK\n        string KioskName \&quot;nvarchar(max)\&quot;\n        string MacAddress UK \&quot;varchar(50)\&quot;\n        int Status\n        datetime LastPingAt \&quot;datetime2, NULL\&quot;\n        int AreaId FK \&quot;int, NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    KioskIncidents {\n        int IncidentId PK\n        int KioskId FK\n        string ErrorCode \&quot;nvarchar(max)\&quot;\n        string Description \&quot;nvarchar(max)\&quot;\n        datetime ResolvedAt \&quot;datetime2, NULL\&quot;\n        datetime CreatedAt\n        datetime UpdatedAt \&quot;datetime2, NULL\&quot;\n    }\n\n    %% Child FK optionality shown by o| (zero or one parent) where nullable.\n    Categories ||--o{ Books : classifies\n    Areas o|--o{ Books : stores\n    Areas o|--o{ Kiosks : locates\n    Suppliers ||--o{ ImportReceipts : supplies\n    Users ||--o{ ImportReceipts : creates\n    ImportReceipts ||--o{ ImportReceiptDetails : contains\n    Books ||--o{ ImportReceiptDetails : imported\n    Users o|--o{ Orders : processes\n    Members o|--o{ Orders : purchases\n    Promotions o|--o{ Orders : applies\n    Orders ||--o{ OrderDetails : contains\n    Books ||--o{ OrderDetails : sold\n    Orders ||--o{ PaymentTransactions : payments\n    Members ||--o{ PointTransactions : points\n    Orders o|--o{ PointTransactions : originates\n    Promotions ||--o| PromotionOrderDiscounts : order_discount\n    Promotions ||--o{ PromotionProductDiscounts : product_discount\n    Books ||--o{ PromotionProductDiscounts : discounted\n    Kiosks ||--o{ KioskIncidents : incidents\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LTuSFD9bHci8qQHlcbW--2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

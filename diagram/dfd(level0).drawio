        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n    KH[\&quot;E1. Khách hàng\&quot;]\n    SCAN[\&quot;E5. Máy quét mã vạch\&quot;]\n    SEP[\&quot;E4. SePay\&quot;]\n    PRN[\&quot;E6. Máy in hóa đơn (Mock / tùy chọn)\&quot;]\n    P4[\&quot;4.0 Thành viên và điểm\&quot;]\n    P5[\&quot;5.0 Quản lý khuyến mãi\&quot;]\n\n    D1[(\&quot;D1. Books / Categories / Areas\&quot;)]\n    D5[(\&quot;D5. Orders / OrderDetails\&quot;)]\n    D6[(\&quot;D6. PaymentTransactions\&quot;)]\n\n    P21((\&quot;2.1 Tra cứu sách và quét mã\&quot;))\n    P22((\&quot;2.2 Quản lý giỏ hàng tạm\&quot;))\n    P23((\&quot;2.3 Kiểm tra thành viên, điểm, khuyến mãi\&quot;))\n    P24((\&quot;2.4 Tạo order Pending và giữ kho\&quot;))\n    P25((\&quot;2.5 Sinh QR và chờ thanh toán\&quot;))\n    P26((\&quot;2.6 Xác thực webhook, cập nhật thanh toán và polling\&quot;))\n    P27((\&quot;2.7 Hiển thị / in hóa đơn\&quot;))\n    P28((\&quot;2.8 Hủy đơn hoặc xử lý hết hạn\&quot;))\n\n    %% 2.1 Tra cứu sách\n    KH --&gt;|\&quot;Từ khóa, bộ lọc, yêu cầu chi tiết\&quot;| P21\n    SCAN --&gt;|\&quot;Mã barcode\&quot;| P21\n    D1 --&gt;|\&quot;Thông tin sách, danh mục, giá, tồn khả dụng\&quot;| P21\n    P21 --&gt;|\&quot;Danh sách sách, chi tiết và thông báo hết hàng\&quot;| KH\n    P21 --&gt;|\&quot;Sách được chọn: BookId, giá, tồn\&quot;| P22\n\n    %% 2.2 Giỏ hàng\n    KH --&gt;|\&quot;Thêm, sửa số lượng, xóa sách\&quot;| P22\n    P22 --&gt;|\&quot;Giỏ hàng tạm và tạm tính\&quot;| KH\n    P22 --&gt;|\&quot;Items và SubTotal dự kiến\&quot;| P23\n\n    %% 2.3 Thành viên, điểm, khuyến mãi\n    KH --&gt;|\&quot;Số điện thoại, số điểm muốn dùng\&quot;| P23\n    P23 --&gt;|\&quot;Yêu cầu tra cứu và kiểm tra điểm\&quot;| P4\n    P4 --&gt;|\&quot;MemberId, Points, điều kiện hợp lệ\&quot;| P23\n    P23 --&gt;|\&quot;Giỏ hàng và yêu cầu áp khuyến mãi\&quot;| P5\n    P5 --&gt;|\&quot;Mã ưu đãi, mức giảm được áp dụng\&quot;| P23\n    P23 --&gt;|\&quot;Tạm tính sau giảm, điểm hợp lệ, số tiền dự kiến\&quot;| KH\n    P23 --&gt;|\&quot;Items, MemberId, PointsToUse\&quot;| P24\n\n    %% 2.4 Checkout và giữ kho\n    KH --&gt;|\&quot;Xác nhận checkout\&quot;| P24\n    D1 --&gt;|\&quot;Giá hiện tại, IsActive, StockQuantity, ReservedQuantity\&quot;| P24\n    P24 --&gt;|\&quot;ReservedQuantity tăng nguyên tử khi còn kho\&quot;| D1\n    P24 --&gt;|\&quot;Order và OrderDetails ở trạng thái Pending\&quot;| D5\n    P24 --&gt;|\&quot;Lỗi số lượng, điểm, nghiệp vụ nếu có\&quot;| KH\n    P24 --&gt;|\&quot;OrderId, OrderCode, TotalAmount, dữ liệu QR\&quot;| P25\n\n    %% 2.5 QR và chờ\n    P25 --&gt;|\&quot;QR chuyển khoản, mã đơn, tiền cần trả\&quot;| KH\n    P25 --&gt;|\&quot;OrderId và yêu cầu kiểm tra trạng thái\&quot;| P26\n    P25 --&gt;|\&quot;Tín hiệu hết thời gian chờ\&quot;| P28\n\n    %% 2.6 Webhook, Paid và polling\n    SEP --&gt;|\&quot;Webhook: transaction id, amount, content, authentication\&quot;| P26\n    D6 --&gt;|\&quot;ReferenceCode đã ghi nhận / giao dịch trước đó\&quot;| P26\n    D5 --&gt;|\&quot;Order Pending, mã đơn, số tiền cần thu\&quot;| P26\n    P26 --&gt;|\&quot;Giao dịch đã xác thực và ghi nhận\&quot;| D6\n    P26 --&gt;|\&quot;Pending sang Paid khi thanh toán hợp lệ\&quot;| D5\n    P26 --&gt;|\&quot;Trừ StockQuantity và ReservedQuantity khi Paid\&quot;| D1\n    P26 --&gt;|\&quot;Sự kiện Paid: trừ điểm đã dùng, cộng điểm tích lũy\&quot;| P4\n    P26 --&gt;|\&quot;Trạng thái Pending, Paid hoặc Cancelled\&quot;| KH\n    P26 --&gt;|\&quot;Đơn đã Paid\&quot;| P27\n    P26 --&gt;|\&quot;Trạng thái Cancelled hoặc hết hạn\&quot;| P28\n\n    %% 2.7 Hóa đơn\n    D5 --&gt;|\&quot;Mã đơn, chi tiết, tổng tiền, trạng thái Paid\&quot;| P27\n    P27 --&gt;|\&quot;Hóa đơn PDF và kết quả thanh toán\&quot;| KH\n    P27 --&gt;|\&quot;Dữ liệu lệnh in hóa đơn\&quot;| PRN\n\n    %% 2.8 Hủy đơn và hết hạn\n    KH --&gt;|\&quot;Yêu cầu hủy thanh toán\&quot;| P28\n    D5 --&gt;|\&quot;Trạng thái Order và CreatedAt\&quot;| P28\n    P28 --&gt;|\&quot;Pending sang Cancelled khi đủ điều kiện\&quot;| D5\n    P28 --&gt;|\&quot;Giảm ReservedQuantity đúng một lần\&quot;| D1\n    P28 --&gt;|\&quot;Xác nhận hủy hoặc đã được thanh toán\&quot;| KH\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pzw-9wztysno2wp6knjy-1">

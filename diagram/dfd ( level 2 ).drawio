<mxfile host="app.diagrams.net">
  <diagram name="dfd ( level 2 )" id="qhH52OYbz6A3iVz4sMp1">
    <mxGraphModel dx="9085" dy="4069" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% DFD Level 2: phan ra tien trinh 2.0 BAN HANG TAI KIOSK cua Level 1\n    %% 4.0 va 5.0 la xu ly KHAC ben ngoai tien trinh 2.0, khong phai external actor.\n    %% Khong viet gio hang vao DB: CartService dang giu gio hang tam o frontend.\n\n    KH[\&quot;E1. Khách hàng\&quot;]\n    SCAN[\&quot;E5. Máy quét mã vạch\&quot;]\n    SEP[\&quot;E4. SePay\&quot;]\n    PRN[\&quot;E6. Máy in hóa đơn (Mock / tùy chọn)\&quot;]\n    P4[\&quot;4.0 Thành viên và điểm\&quot;]\n    P5[\&quot;5.0 Quản lý khuyến mãi\&quot;]\n\n    D1[(\&quot;D1. Books / Categories / Areas\&quot;)]\n    D5[(\&quot;D5. Orders / OrderDetails\&quot;)]\n    D6[(\&quot;D6. PaymentTransactions\&quot;)]\n\n    P21((\&quot;2.1 Tra cứu sách và quét mã\&quot;))\n    P22((\&quot;2.2 Quản lý giỏ hàng tạm\&quot;))\n    P23((\&quot;2.3 Kiểm tra thành viên, điểm, khuyến mãi\&quot;))\n    P24((\&quot;2.4 Tạo order Pending và giữ kho\&quot;))\n    P25((\&quot;2.5 Sinh QR và chờ thanh toán\&quot;))\n    P26((\&quot;2.6 Xác thực webhook, cập nhật thanh toán và polling\&quot;))\n    P27((\&quot;2.7 Hiển thị / in hóa đơn\&quot;))\n    P28((\&quot;2.8 Hủy Pending / Backend dọn đơn quá hạn\&quot;))\n\n    %% 2.1 Tim sach\n    KH --&gt;|\&quot;Từ khóa, bộ lọc, yêu cầu chi tiết\&quot;| P21\n    SCAN --&gt;|\&quot;Mã barcode\&quot;| P21\n    D1 --&gt;|\&quot;Thông tin sách, danh mục, giá, tồn khả dụng\&quot;| P21\n    P21 --&gt;|\&quot;Danh sách sách, chi tiết và thông báo hết hàng\&quot;| KH\n    P21 --&gt;|\&quot;Sách được chọn: BookId, giá, tồn\&quot;| P22\n\n    %% 2.2 Gio hang (bo nho tam)\n    KH --&gt;|\&quot;Thêm, sửa số lượng, xóa sách\&quot;| P22\n    P22 --&gt;|\&quot;Giỏ hàng tạm và tạm tính\&quot;| KH\n    P22 --&gt;|\&quot;Items và SubTotal dự kiến\&quot;| P23\n\n    %% 2.3 Thanh vien, promotion\n    KH --&gt;|\&quot;Số điện thoại, số điểm muốn dùng\&quot;| P23\n    P23 --&gt;|\&quot;Yêu cầu tra cứu và kiểm tra điểm\&quot;| P4\n    P4 --&gt;|\&quot;MemberId, Points, điều kiện hợp lệ\&quot;| P23\n    P23 --&gt;|\&quot;Giỏ hàng và yêu cầu áp khuyến mãi\&quot;| P5\n    P5 --&gt;|\&quot;Mã ưu đãi, mức giảm được áp dụng\&quot;| P23\n    P23 --&gt;|\&quot;Tạm tính sau giảm, điểm hợp lệ, số tiền dự kiến\&quot;| KH\n    P23 --&gt;|\&quot;Items, MemberId, PointsToUse\&quot;| P24\n\n    %% 2.4 Checkout backend tu tinh lai, validate va giu kho\n    KH --&gt;|\&quot;Xác nhận checkout\&quot;| P24\n    D1 --&gt;|\&quot;Giá hiện tại, IsActive, StockQuantity, ReservedQuantity\&quot;| P24\n    P24 --&gt;|\&quot;ReservedQuantity tăng nguyên tử khi còn kho\&quot;| D1\n    P24 --&gt;|\&quot;Order và OrderDetails ở trạng thái Pending\&quot;| D5\n    P24 --&gt;|\&quot;Lỗi số lượng, điểm, nghiệp vụ nếu có\&quot;| KH\n    P24 --&gt;|\&quot;OrderId, OrderCode, TotalAmount, dữ liệu QR\&quot;| P25\n\n    %% 2.5 QR do backend tao; SePay khong can endpoint tao order\n    P25 --&gt;|\&quot;QR chuyển khoản, mã đơn, tiền cần trả\&quot;| KH\n    P25 --&gt;|\&quot;OrderId và yêu cầu kiểm tra trạng thái\&quot;| P26\n    %% Khong ve P25 -&gt; P28 nhu timer UI chu dong huy don.\n    %% Backend job tu quet Order Pending qua OrderTimeoutMinutes.\n    %% 2.6 Nhan webhook tu SePay, xu ly giao dich va polling\n    SEP --&gt;|\&quot;Webhook: transaction id, amount, content, authentication\&quot;| P26\n    D6 --&gt;|\&quot;ReferenceCode đã ghi nhận / giao dịch trước đó\&quot;| P26\n    D5 --&gt;|\&quot;Order Pending, mã đơn, số tiền cần thu\&quot;| P26\n    P26 --&gt;|\&quot;Giao dịch đã xác thực và ghi nhận\&quot;| D6\n    P26 --&gt;|\&quot;Pending sang Paid khi thanh toán hợp lệ\&quot;| D5\n    P26 --&gt;|\&quot;Trừ StockQuantity và ReservedQuantity khi Paid\&quot;| D1\n    P26 --&gt;|\&quot;Sự kiện Paid: trừ điểm đã dùng, cộng điểm tích lũy\&quot;| P4\n    P26 --&gt;|\&quot;Trạng thái Pending, Paid hoặc Cancelled\&quot;| KH\n    P26 --&gt;|\&quot;Đơn đã Paid\&quot;| P27\n\n    %% 2.7 Hoa don: chi tao khi Paid\n    D5 --&gt;|\&quot;Mã đơn, chi tiết, tổng tiền, trạng thái Paid\&quot;| P27\n    P27 --&gt;|\&quot;Hóa đơn PDF và kết quả thanh toán\&quot;| KH\n    P27 --&gt;|\&quot;Dữ liệu lệnh in hóa đơn\&quot;| PRN\n\n    %% 2.8 Cancel va cleanup (chi Pending moi duoc huy)\n    KH --&gt;|\&quot;Yêu cầu hủy thanh toán\&quot;| P28\n    D5 --&gt;|\&quot;OrderStatus Pending và CreatedAt để job kiểm tra TTL\&quot;| P28\n    P28 --&gt;|\&quot;Pending sang Cancelled khi đủ điều kiện\&quot;| D5\n    P28 --&gt;|\&quot;Giảm ReservedQuantity đúng một lần\&quot;| D1\n    P28 --&gt;|\&quot;Xác nhận hủy hoặc đã được thanh toán\&quot;| KH\n\n    NOTE[\&quot;GHI CHÚ: UI Kiosk chỉ đếm ngược/polling. Backend định kỳ kiểm tra Pending quá hạn và giải phóng ReservedQuantity; không phụ thuộc timer UI. F3 DEV/Receipt đang chờ Backend.\&quot;]\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nZtUjWAU_GjGS5NziYlm-95">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

<Page x:Class="BookKiosk.Kiosk.Pages.IdlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookKiosk.Kiosk.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="IdlePage">

    <Grid Background="#2c3e50">
        <!-- Chỗ chứa video hoặc ảnh nền (cập nhật sau nếu có tài nguyên) -->
        
        <TextBlock Text="CHẠM VÀO MÀN HÌNH ĐỂ BẮT ĐẦU" 
                   Foreground="White" 
                   FontSize="60" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   IsHitTestVisible="False" />
                   
        <!-- Nút bấm vô hình bao trùm toàn bộ màn hình để bắt sự kiện -->
        <Button Command="{Binding StartCommand}"
                Background="Transparent" 
                BorderBrush="Transparent"
                Foreground="Transparent"
                Cursor="Hand"
                Focusable="False"/>
    </Grid>
</Page>

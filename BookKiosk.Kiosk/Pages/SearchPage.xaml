<Page x:Class="BookKiosk.Kiosk.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:BookKiosk.Kiosk.Controls"
      Title="SearchPage" Background="#f0f2f5"
      d:DesignHeight="1080" d:DesignWidth="1920"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Background="#f0f2f5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: Tìm kiếm và Kết quả -->
        <Grid Grid.Column="0" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Thanh công cụ tìm kiếm -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="⬅ VỀ TRANG CHỦ" Command="{Binding HomeCommand}" FontSize="28" FontWeight="Bold" Background="#e74c3c" Foreground="White" Padding="20,15" Margin="0,0,20,0" Focusable="False">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                </Button>
                <!-- Thêm Placeholder Text bằng VisualBrush hoặc dùng IsReadOnly để cấm gõ phím cứng -->
                <TextBox Grid.Column="1" Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="32" Padding="20" BorderBrush="#bdc3c7" BorderThickness="2" VerticalContentAlignment="Center" Background="White" IsReadOnly="True" />
            </Grid>

            <!-- Bộ lọc thể loại -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="24" Background="#3498db" Foreground="White" Padding="25,10" Margin="0,0,15,15" Focusable="False">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                            </Button.Resources>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Lưới kết quả (Card Sách) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="420"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.BookClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding BookId}" Background="White" BorderBrush="Transparent" Margin="0,0,40,40" Cursor="Hand" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" CornerRadius="15" Padding="20">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#cccccc" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Image Source="{Binding ImageUrl}" Height="400" Stretch="UniformToFill" Margin="0,0,0,15"/>
                                                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SellingPrice, StringFormat={}{0:N0} đ}" FontSize="24" Foreground="#e74c3c" FontWeight="Bold" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Khu vực Bàn phím QWERTY ảo -->
            <controls:VirtualKeyboardQWERTYControl Grid.Row="3" TargetText="{Binding Keyword, Mode=TwoWay}" Margin="0,20,0,0"/>
        </Grid>

        <!-- CỘT PHẢI: Giỏ Hàng -->
        <controls:CartView Grid.Column="1" />
    </Grid>
</Page>

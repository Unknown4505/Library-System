<Page x:Class="BookKiosk.Kiosk.Pages.BookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:BookKiosk.Kiosk.Controls"
      Title="BookDetailPage" Background="#f0f2f5"
      d:DesignHeight="1080" d:DesignWidth="1920"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: Chi tiết Sách -->
        <Grid Grid.Column="0" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nút Quay lại -->
            <Button Grid.Row="0" Content="⬅ QUAY LẠI" Command="{Binding BackCommand}" HorizontalAlignment="Left" FontSize="28" FontWeight="Bold" Background="#95a5a6" Foreground="White" Padding="20,15" Margin="0,0,0,30">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                </Button.Resources>
            </Button>

            <!-- Chi tiết sách -->
            <Grid Grid.Row="1" Background="White" Margin="0,0,0,30">
                <Border CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.3"/>
                    </Border.Effect>
                </Border>
                <Grid Margin="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Book.ImageUrl}" Stretch="Uniform" Margin="0,0,40,0"/>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{Binding Book.Title}" FontSize="56" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding Book.Author, StringFormat='Tác giả: {0}'}" FontSize="32" Foreground="#7f8c8d" Margin="0,0,0,30"/>
                            
                            <TextBlock Text="{Binding Book.SellingPrice, StringFormat='Giá: {0:N0} đ'}" FontSize="48" FontWeight="Bold" Foreground="#e74c3c" Margin="0,0,0,40"/>
                            
                            <!-- Dải ngăn cách -->
                            <Rectangle Height="2" Fill="#ecf0f1" Margin="0,0,0,40"/>
                            
                            <!-- Trạng thái Tồn kho -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                <TextBlock Text="📦 Trạng thái kho: " FontSize="32" Foreground="#34495e"/>
                                <TextBlock Text="{Binding Book.AvailableStock, StringFormat='Còn {0} quyển'}" FontSize="32" Foreground="#27ae60" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Sơ đồ vị trí kệ sách -->
                            <TextBlock Text="📍 Sơ đồ vị trí kệ sách:" FontSize="32" Foreground="#34495e" Margin="0,0,0,15" FontWeight="Bold"/>
                            <Border Background="#ecf0f1" Height="280" CornerRadius="10" BorderBrush="#bdc3c7" BorderThickness="2" Margin="0,0,0,20" ClipToBounds="True">
                                <Grid Background="#fdfdfd" Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bản đồ nền mô phỏng -->
                                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Khu A1" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Khu B1" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Khu C1" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Khu A2" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Khu B2" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="#ecf0f1" BorderThickness="2" Margin="5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Khu C2" Foreground="#bdc3c7" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Kệ sách nổi bật & Chấm đỏ (Binding tự động đổi Grid.Row/Column) -->
                                    <Border Background="#34495e" CornerRadius="8" Margin="5" Panel.ZIndex="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Grid.Row" Value="0"/>
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ A1">
                                                        <Setter Property="Grid.Row" Value="0"/> <Setter Property="Grid.Column" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ B1">
                                                        <Setter Property="Grid.Row" Value="0"/> <Setter Property="Grid.Column" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ C1">
                                                        <Setter Property="Grid.Row" Value="0"/> <Setter Property="Grid.Column" Value="2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ A2">
                                                        <Setter Property="Grid.Row" Value="1"/> <Setter Property="Grid.Column" Value="0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ B2">
                                                        <Setter Property="Grid.Row" Value="1"/> <Setter Property="Grid.Column" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Book.AreaName}" Value="Kệ C2">
                                                        <Setter Property="Grid.Row" Value="1"/> <Setter Property="Grid.Column" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="{Binding Book.AreaName}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse Width="35" Height="35" Fill="#e74c3c" Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-15,0,0">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#e74c3c" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                </Ellipse.Effect>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Nút Thêm vào giỏ hàng bự -->
            <Button Grid.Row="2" Content="🛒 THÊM VÀO GIỎ HÀNG" Command="{Binding AddToCartCommand}" FontSize="40" FontWeight="Bold" Background="#e67e22" Foreground="White" Height="120">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="15"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
        
        <!-- CỘT PHẢI: Giỏ hàng Sidebar -->
        <controls:CartView Grid.Column="1"/>
    </Grid>
</Page>

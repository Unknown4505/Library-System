<Page x:Class="BookKiosk.Kiosk.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BookKiosk.Kiosk.Pages"
      xmlns:controls="clr-namespace:BookKiosk.Kiosk.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="HomePage">

    <Grid Background="#f0f2f5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: Tìm kiếm và Danh sách Sách -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh Tìm Kiếm / Nút to ở phía trên -->
            <Border Grid.Row="0" Background="White" Padding="40" Margin="40,40,40,20" CornerRadius="15">
                <Button Content="🔍 BẤM VÀO ĐÂY ĐỂ TÌM SÁCH / TRA CỨU" 
                        Command="{Binding SearchCommand}"
                        Background="#3498db" 
                        Foreground="White" 
                        FontSize="36" 
                        FontWeight="Bold" 
                        Height="100" 
                        Cursor="Hand"
                        Focusable="False">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Border>

            <!-- Vùng hiển thị sách nổi bật -->
            <Grid Grid.Row="1" Margin="40,20,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📚 SÁCH GỢI Ý CHO BẠN" FontSize="40" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,30" />

                <!-- Hiển thị Card bằng ItemsControl và WrapPanel -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FeaturedBooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="420" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Nút bấm ẩn bao bọc toàn bộ Card để bắt sự kiện Click, truyền BookId dạng int -->
                                <Button Command="{Binding DataContext.BookClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                        CommandParameter="{Binding BookId}"
                                        Background="Transparent" BorderBrush="Transparent" Margin="0,0,40,40" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="White" CornerRadius="15" Padding="20">
                                                <!-- DropShadow Effect -->
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#cccccc" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="500"/> <!-- Ảnh bìa lớn -->
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <Image Grid.Row="0" Source="{Binding ImageUrl}" Stretch="UniformToFill" Margin="0,0,0,20"/>
                                                    
                                                    <!-- Tiêu đề bự -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                                    
                                                    <!-- Giá tiền -->
                                                    <TextBlock Grid.Row="2" Text="{Binding SellingPrice, StringFormat={}{0:N0} đ}" FontSize="24" Foreground="#e74c3c" FontWeight="Bold" Margin="0,10,0,0"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- CỘT PHẢI: Giỏ Hàng -->
        <controls:CartView Grid.Column="1" />
    </Grid>
</Page>

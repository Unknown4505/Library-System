<Window x:Class="BookKiosk.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookKiosk.Kiosk"
        xmlns:controls="clr-namespace:BookKiosk.Kiosk.Controls"
        mc:Ignorable="d"
        Title="BookKiosk" Height="1080" Width="1920"
        WindowStyle="None" WindowState="Maximized" Topmost="False" ResizeMode="NoResize"
        PreviewMouseMove="Window_PreviewInteraction"
        PreviewTouchDown="Window_PreviewInteraction"
        PreviewMouseDown="Window_PreviewInteraction"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <!-- Bộ khung chứa các trang -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        
        <!-- Nút thoát [DEV-ONLY] (Nút dấu X màu đỏ ở góc trên trái) -->
        <Button Width="46" Height="46" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="12" Content="✕" FontSize="24" FontWeight="Bold"
                Foreground="#e74c3c" Background="White" BorderBrush="#e74c3c" BorderThickness="2"
                Click="DevExitButton_Click" Cursor="Hand" Focusable="False"
                Panel.ZIndex="9999" ToolTip="Nhấp đúp để thoát Kiosk (Bảo trì)">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="23"/>
                </Style>
            </Button.Resources>
            <Button.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Button.Effect>
        </Button>
                
        <!-- [DEV-ONLY] TextBox để nhập tay mã Barcode (Mở bằng F2) -->
        <Border x:Name="DevBarcodeBorder" Visibility="Collapsed" 
                VerticalAlignment="Top" HorizontalAlignment="Center" 
                Background="White" Padding="15" Margin="0,50,0,0" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="[DEV] Nhập Barcode:" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="18"/>
                <TextBox x:Name="DevBarcodeTextBox" Width="250" Height="40" FontSize="20" Padding="5"
                         KeyDown="DevBarcodeTextBox_KeyDown" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Kiosk Dialog Overlay -->
        <controls:CustomKioskDialogControl x:Name="OverlayDialog" />
    </Grid>
</Window>

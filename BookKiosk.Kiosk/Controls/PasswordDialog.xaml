<Window x:Class="BookKiosk.Kiosk.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảo trì hệ thống" Height="300" Width="450" 
        WindowStartupLocation="CenterOwner" 
        WindowStyle="ToolWindow" 
        Topmost="True" 
        ResizeMode="NoResize">
    <Border Padding="30" Background="#f8f9fa">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="🔒 VUI LÒNG NHẬP MẬT KHẨU" 
                       FontSize="20" FontWeight="Bold" Foreground="#e74c3c" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <PasswordBox x:Name="pwdBox" Height="45" FontSize="24" Padding="5" Margin="0,0,0,20" 
                         HorizontalContentAlignment="Center"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="HỦY" Height="50" FontSize="18" FontWeight="Bold" 
                        Background="#95a5a6" Foreground="White" Click="CancelButton_Click" Cursor="Hand"/>
                
                <Button Grid.Column="2" Content="XÁC NHẬN" Height="50" FontSize="18" FontWeight="Bold" 
                        Background="#2ecc71" Foreground="White" Click="ConfirmButton_Click" IsDefault="True" Cursor="Hand"/>
            </Grid>
            
            <TextBlock x:Name="txtError" Text="Mật khẩu không chính xác!" Foreground="Red" FontSize="16" 
                       HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="BookKiosk.Kiosk.Controls.MockReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localConverters="clr-namespace:BookKiosk.Kiosk.Converters"
        Title="Giả lập In Hóa đơn" Height="700" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <localConverters:PromotionTypeToStringConverter x:Key="PromotionTypeToStringConverter"/>
        <localConverters:DecimalGreaterThanZeroToVisibilityConverter x:Key="DecimalGreaterThanZeroToVisibilityConverter"/>
    </Window.Resources>
    
    <!-- Tờ hóa đơn mô phỏng giấy in nhiệt K80 -->
    <Border Background="#fdfbf7" BorderBrush="#bdc3c7" BorderThickness="1" CornerRadius="0,0,10,10" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header Hóa đơn -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="BOOK KIOSK" FontFamily="Courier New" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="123 Nguyễn Văn Cừ, Q.5, TP.HCM" FontFamily="Courier New" FontSize="12" HorizontalAlignment="Center"/>
                <TextBlock Text="--------------------------------" FontFamily="Courier New" FontSize="18" HorizontalAlignment="Center" Margin="0,5,0,5"/>
                <TextBlock Text="HÓA ĐƠN BÁN HÀNG" FontFamily="Courier New" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Receipt.OrderCode, StringFormat='Mã ĐH: #{0}'}" FontFamily="Courier New" FontSize="13" Margin="0,3,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayCompletedAt, StringFormat='Thời gian: {0:dd/MM/yyyy HH:mm:ss}'}" FontFamily="Courier New" FontSize="12" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="--------------------------------" FontFamily="Courier New" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Danh sách Hàng hóa -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,5,0,5">
                <ItemsControl ItemsSource="{Binding Receipt.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding BookTitle}" FontFamily="Courier New" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat={}{0} x }" FontFamily="Courier New" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding UnitPriceAtTime, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="12"/>
                                        <TextBlock Text="{Binding DiscountPerUnit, StringFormat=' (-{0:N0}đ/c)'}" FontFamily="Courier New" FontSize="11" Foreground="#27ae60" FontWeight="Bold"
                                                   Visibility="{Binding LineDiscountAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <!-- Thành tiền: QUY TẮC CHỌN TRƯỜNG Q1 -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <!-- Khi LineDiscountAmount > 0: Hiện LineTotal gạch ngang + NetLineTotal đậm -->
                                        <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="11" Foreground="#7f8c8d" TextDecorations="Strikethrough" HorizontalAlignment="Right"
                                                   Visibility="{Binding LineDiscountAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding NetLineTotal, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                                                   Visibility="{Binding LineDiscountAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}}"/>
                                        <!-- Khi LineDiscountAmount == 0: Chỉ hiện LineTotal, TUYỆT ĐỐI KHÔNG hiện NetLineTotal -->
                                        <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                                                   Visibility="{Binding LineDiscountAmount, Converter={StaticResource DecimalGreaterThanZeroToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Footer Hóa đơn -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="--------------------------------" FontFamily="Courier New" FontSize="18" HorizontalAlignment="Center"/>
                
                <!-- Tạm tính -->
                <Grid Margin="0,3,0,2">
                    <TextBlock Text="Tạm tính:" FontFamily="Courier New" FontSize="13"/>
                    <TextBlock Text="{Binding Receipt.SubTotal, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="13" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Giảm giá khuyến mãi -->
                <StackPanel Margin="0,2,0,2" Visibility="{Binding HasPromotionDiscount, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="{Binding PromotionDisplayName, StringFormat='{}{0}:'}" FontFamily="Courier New" FontSize="13"/>
                        <TextBlock Text="{Binding Receipt.DiscountAmount, StringFormat='-{0:N0} đ'}" FontFamily="Courier New" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="{Binding Receipt.PromotionType, Converter={StaticResource PromotionTypeToStringConverter}, ConverterParameter=Parens}" 
                               FontFamily="Courier New" FontSize="11" FontStyle="Italic" Foreground="#555" Margin="5,1,0,0"
                               Visibility="{Binding HasPromotionType, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Điểm thành viên -->
                <Grid Margin="0,2,0,2" Visibility="{Binding HasPointsDiscount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Receipt.PointsUsed, StringFormat='Điểm ({0}đ):'}" FontFamily="Courier New" FontSize="13"/>
                    <TextBlock Text="{Binding Receipt.PointsUsedAmount, StringFormat='-{0:N0} đ'}" FontFamily="Courier New" FontSize="13" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Text="--------------------------------" FontFamily="Courier New" FontSize="18" HorizontalAlignment="Center"/>

                <!-- Tổng tiền -->
                <Grid Margin="0,5,0,5">
                    <TextBlock Text="TỔNG TIỀN:" FontFamily="Courier New" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Receipt.TotalAmount, StringFormat='{}{0:N0} đ'}" FontFamily="Courier New" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Phương thức thanh toán -->
                <TextBlock Text="{Binding Receipt.PaymentMethod, StringFormat='ĐÃ THANH TOÁN ({0})'}" FontFamily="Courier New" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,5" FontWeight="Bold"/>
                
                <TextBlock Text="--------------------------------" FontFamily="Courier New" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="Cảm ơn quý khách!" FontFamily="Courier New" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,2" FontWeight="Bold"/>
                <TextBlock Text="Hẹn gặp lại" FontFamily="Courier New" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="BookKiosk.Kiosk.Controls.VirtualKeyboardQWERTYControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="1000" d:DesignHeight="350">
    <UserControl.Resources>
        <!-- Style cơ bản cho các nút phím -->
        <Style TargetType="Button" x:Key="KeyButtonStyle">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#bdc3c7" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#cccccc" BlurRadius="5" ShadowDepth="3" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#ecf0f1"/>
                                <Setter Property="Foreground" Value="#2980b9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho các nút Đặc biệt (Xóa, Tìm) -->
        <Style TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}" x:Key="ActionButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f2f5" Margin="10">
        <StackPanel VerticalAlignment="Center">
            <!-- Hàng 1: Số -->
            <UniformGrid Rows="1" Columns="10" Margin="0,0,0,5">
                <Button Style="{StaticResource KeyButtonStyle}" Content="1" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="2" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="3" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="4" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="5" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="6" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="7" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="8" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="9" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="0" Click="Char_Click"/>
            </UniformGrid>

            <!-- Hàng 2: QWERTY -->
            <UniformGrid Rows="1" Columns="10" Margin="20,0,20,5">
                <Button Style="{StaticResource KeyButtonStyle}" Content="Q" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="W" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="E" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="R" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="T" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="Y" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="U" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="I" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="O" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="P" Click="Char_Click"/>
            </UniformGrid>

            <!-- Hàng 3: ASDFGHJKL -->
            <UniformGrid Rows="1" Columns="9" Margin="50,0,50,5">
                <Button Style="{StaticResource KeyButtonStyle}" Content="A" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="S" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="D" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="F" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="G" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="H" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="J" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="K" Click="Char_Click"/>
                <Button Style="{StaticResource KeyButtonStyle}" Content="L" Click="Char_Click"/>
            </UniformGrid>

            <!-- Hàng 4: ZXCVBNM + Backspace + Search -->
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Backspace (Trái) -->
                <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Content="⌫ XÓA" Background="#e74c3c" Width="150" Click="Backspace_Click">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <!-- Hiệu ứng nổi bật khi bấm (không bắt buộc vì đã có trigger trong style) -->
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Cụm ZXCVBNM (Giữa) -->
                <UniformGrid Grid.Column="1" Rows="1" Columns="7" Margin="20,0,20,0">
                    <Button Style="{StaticResource KeyButtonStyle}" Content="Z" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="X" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="C" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="V" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="B" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="N" Click="Char_Click"/>
                    <Button Style="{StaticResource KeyButtonStyle}" Content="M" Click="Char_Click"/>
                </UniformGrid>

                <!-- Enter / Tìm kiếm (Phải) -->
                <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Content="TÌM 🔍" Background="#3498db" Width="150" Click="Enter_Click"/>
            </Grid>

            <!-- Hàng 5: Space Bar -->
            <Grid Margin="150,5,150,0">
                <Button Style="{StaticResource KeyButtonStyle}" Content="DẤU CÁCH (SPACE)" FontSize="24" Background="#ecf0f1" Height="70" Click="Space_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
